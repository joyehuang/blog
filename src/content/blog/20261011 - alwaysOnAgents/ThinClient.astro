---
/**
 * ThinClient.astro
 *
 * 常驻 Agent 那篇博文第三节的图：薄客户端和厚服务器之间只有一个工具 SendToUser。
 * 动效：一个小圆点在中间那条线上来回走，表示消息在两端之间往返；只在图进入视口后才开始。
 * prefers-reduced-motion 下圆点静止在中间。
 */
import './figures.css'

import { thinCopy, type FigLocale } from './copy'
import RevealBoot from './RevealBoot.astro'

interface Props {
  locale?: FigLocale
}

const { locale = 'zh' } = Astro.props
const t = thinCopy(locale)
---

<figure class='aoa-fig aoa-thin not-prose' data-aoa-thin data-locale={locale}>
  <figcaption class='aoa-cap'>
    <strong>{t.captionStrong}</strong>{t.captionRest}
  </figcaption>

  <div class='aoa-thin-row'>
    <div class='aoa-card aoa-thin-side aoa-rv' style='--i: 0'>
      <p class='aoa-kicker'>{t.clientKicker}</p>
      <p class='aoa-title'>{t.clientTitle}</p>
      <p class='aoa-sub'>{t.clientSub}</p>
      <ul class='aoa-list'>
        {t.clientItems.map((item) => <li>{item}</li>)}
      </ul>
    </div>

    <div class='aoa-thin-wire aoa-rv' style='--i: 1'>
      <span class='aoa-thin-line' aria-hidden='true'><span class='aoa-thin-dot'></span></span>
      <span class='aoa-thin-pill'>{t.pill}</span>
      <span class='aoa-thin-only'>{t.only}</span>
    </div>

    <div class='aoa-card aoa-card-accent aoa-thin-side aoa-rv' style='--i: 2'>
      <p class='aoa-kicker'>{t.serverKicker}</p>
      <p class='aoa-title'>{t.serverTitle}</p>
      <ul class='aoa-list'>
        {t.serverItems.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>
  <RevealBoot />
</figure>

<script>
  import { armReveal } from './reveal'

  armReveal('[data-aoa-thin]')
</script>

<style>
  .aoa-thin-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(120px, 0.7fr) minmax(0, 1fr);
    align-items: center;
    gap: 10px;
  }

  .aoa-thin-wire {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .aoa-thin-line {
    position: relative;
    display: block;
    width: 100%;
    height: 2px;
    background: hsl(var(--border));
  }

  .aoa-thin-dot {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 9px;
    height: 9px;
    margin: -4.5px 0 0 -4.5px;
    border-radius: 50%;
    background: hsl(var(--primary));
  }

  .aoa-play .aoa-thin-dot {
    animation: aoa-thin-travel 3.2s ease-in-out infinite;
  }

  @keyframes aoa-thin-travel {
    0%,
    100% {
      left: 4%;
    }
    50% {
      left: 96%;
    }
  }

  .aoa-thin-pill {
    padding: 3px 12px;
    border: 1px solid hsl(var(--primary));
    border-radius: 999px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;
    font-size: 0.82rem;
    font-weight: 600;
    color: hsl(var(--primary));
    background: hsl(var(--background));
  }

  .aoa-thin-only {
    font-size: 0.72rem;
    color: hsl(var(--muted-foreground));
  }

  @media (max-width: 640px) {
    .aoa-thin-row {
      grid-template-columns: minmax(0, 1fr);
    }

    .aoa-thin-wire {
      padding: 6px 0;
    }

    .aoa-thin-line {
      width: 60%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .aoa-play .aoa-thin-dot {
      animation: none;
    }
  }

  .aoa-thin[data-locale='en'] .aoa-thin-only {
    max-width: 11em;
    text-align: center;
    line-height: 1.4;
  }
</style>
