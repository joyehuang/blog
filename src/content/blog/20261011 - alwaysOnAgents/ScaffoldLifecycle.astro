---
/**
 * ScaffoldLifecycle.astro
 *
 * 常驻 Agent 那篇博文第六节的图：模型能力持续上升，补偿层的净价值先升后降，
 * 在交叉点之后变成负担。概念示意，不是实测数据。
 *
 * 动效和 Harness 那篇的 SlopeFigure 一样：线条和色块放在同一个 clipPath 里，
 * 进入视口时裁剪矩形从左往右展开，展开到哪里，哪里的标注就跟着出现。
 * 没有 JS、打印、prefers-reduced-motion 时直接以终态展示。
 */
import './figures.css'

import { lifeCopy, type FigLocale } from './copy'
import RevealBoot from './RevealBoot.astro'

interface Props {
  locale?: FigLocale
}

const { locale = 'zh' } = Astro.props
const t = lifeCopy(locale)
---

<figure class='aoa-fig aoa-life not-prose' data-aoa-life data-locale={locale}>
  <figcaption class='aoa-cap'>
    <strong>{t.captionStrong}</strong>{t.captionRest}
  </figcaption>

  <div class='aoa-life-frame'>
    <svg class='aoa-life-svg' viewBox='0 0 600 330' role='img' aria-label={t.aria}>
      <defs>
        <clipPath id='aoa-life-wipe'>
          <rect class='aoa-life-wipe' x='44' y='0' width='406' height='300'></rect>
        </clipPath>
        <clipPath id='aoa-life-above'>
          <rect x='50' y='0' width='400' height='200'></rect>
        </clipPath>
        <clipPath id='aoa-life-below'>
          <rect x='50' y='200' width='400' height='100'></rect>
        </clipPath>
      </defs>

      <path class='aoa-life-axis' d='M50,25 L50,290 L470,290'></path>
      <path class='aoa-life-zero' d='M50,200 L460,200'></path>
      <text class='aoa-life-muted aoa-life-sm' x='465' y='204'>0</text>

      <g clip-path='url(#aoa-life-wipe)'>
        <g clip-path='url(#aoa-life-above)'>
          <path
            class='aoa-life-gain'
            d='M50,200 C100,120 160,95 210,130 S330,230 440,262 L440,200 Z'></path>
        </g>
        <g clip-path='url(#aoa-life-below)'>
          <path
            class='aoa-life-loss'
            d='M50,200 C100,120 160,95 210,130 S330,230 440,262 L440,200 Z'></path>
        </g>
        <path class='aoa-life-model' d='M50,255 C200,240 320,150 440,48'></path>
        <path class='aoa-life-scaffold' d='M50,200 C100,120 160,95 210,130 S330,230 440,262'></path>
      </g>

      {
        t.groups.map((g) => (
          <g class='aoa-life-late' style={`--at: ${g.at}`}>
            {g.dot && <circle class='aoa-life-dot' cx={g.dot.cx} cy={g.dot.cy} r='5' />}
            {g.labels.map((lb) => (
              <text
                class={lb.className}
                x={lb.x}
                y={lb.y}
                text-anchor={lb.anchor}
                font-weight={lb.weight}
              >
                {lb.text}
              </text>
            ))}
          </g>
        ))
      }

      <text class='aoa-life-muted aoa-life-sm' x='470' y='310' text-anchor='end'>{t.axis}</text>
    </svg>
  </div>

  <p class='aoa-note'>{t.note}</p>
  <RevealBoot />
</figure>

<script>
  import { armReveal } from './reveal'

  armReveal('[data-aoa-life]', undefined, 0.45)
</script>

<style>
  .aoa-life-frame {
    width: 100%;
    max-width: 640px;
    margin: 0 auto;
  }

  .aoa-life-svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .aoa-life-svg text {
    font-family: inherit;
    fill: hsl(var(--foreground));
  }

  .aoa-life-svg .aoa-life-muted {
    fill: hsl(var(--muted-foreground));
  }

  .aoa-life-svg .aoa-life-accent {
    fill: hsl(var(--primary));
  }

  .aoa-life-svg .aoa-life-danger {
    fill: hsl(var(--destructive));
  }

  :global(.dark) .aoa-life-svg .aoa-life-danger {
    fill: hsl(0 70% 72%);
  }

  .aoa-life-sm {
    font-size: 12.5px;
  }

  .aoa-life-md {
    font-size: 14px;
  }

  .aoa-life-axis {
    fill: none;
    stroke: hsl(var(--border));
    stroke-width: 1.5;
  }

  .aoa-life-zero {
    fill: none;
    stroke: hsl(var(--muted-foreground) / 0.5);
    stroke-width: 1;
    stroke-dasharray: 4 4;
  }

  .aoa-life-model {
    fill: none;
    stroke: hsl(var(--foreground));
    stroke-width: 2.5;
    stroke-linecap: round;
  }

  .aoa-life-scaffold {
    fill: none;
    stroke: hsl(var(--primary));
    stroke-width: 2.5;
    stroke-linecap: round;
  }

  .aoa-life-gain {
    fill: hsl(var(--primary) / 0.14);
  }

  .aoa-life-loss {
    fill: hsl(var(--destructive) / 0.12);
  }

  :global(.dark) .aoa-life-loss {
    fill: hsl(0 70% 60% / 0.16);
  }

  .aoa-life-dot {
    fill: hsl(var(--background));
    stroke: hsl(var(--primary));
    stroke-width: 2;
  }

  /* ---------- 动效 ---------- */

  .aoa-life-wipe {
    transform-origin: 44px 0;
  }

  .aoa-armed .aoa-life-wipe {
    transform: scaleX(0);
  }

  .aoa-armed .aoa-life-late {
    opacity: 0;
  }

  .aoa-play .aoa-life-wipe {
    transition: transform 1.9s cubic-bezier(0.35, 0.1, 0.25, 1);
  }

  .aoa-play .aoa-life-late {
    transition: opacity 0.45s ease var(--at, 1.6s);
  }

  @media (max-width: 640px) {
    .aoa-life-sm {
      font-size: 17px;
    }

    .aoa-life-md {
      font-size: 19px;
    }
  }

  /* English labels are longer. Size them in the chart's own coordinates so a
     narrow screen does not blow the text up over the axes. 1.92cqw of the
     600-wide viewBox is about 11.5 user units. */
  .aoa-life[data-locale='en'] .aoa-life-frame {
    container-type: inline-size;
  }

  .aoa-life[data-locale='en'] .aoa-life-sm {
    font-size: 1.92cqw;
  }

  .aoa-life[data-locale='en'] .aoa-life-md {
    font-size: 2.17cqw;
  }

  @media print {
    .aoa-armed .aoa-life-wipe {
      transform: none;
    }

    .aoa-armed .aoa-life-late {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .aoa-play .aoa-life-wipe,
    .aoa-play .aoa-life-late {
      transition: none;
    }
  }
</style>
