---
/**
 * ScaffoldLifecycle.astro
 *
 * 常驻 Agent 那篇博文第六节的图：模型能力持续上升，补偿层的净价值先升后降，
 * 在交叉点之后变成负担。概念示意，不是实测数据。
 *
 * 动效和 Harness 那篇的 SlopeFigure 一样：线条和色块放在同一个 clipPath 里，
 * 进入视口时裁剪矩形从左往右展开，展开到哪里，哪里的标注就跟着出现。
 * 没有 JS、打印、prefers-reduced-motion 时直接以终态展示。
 */
import './figures.css'
---

<figure class='aoa-fig aoa-life not-prose' data-aoa-life>
  <figcaption class='aoa-cap'>
    <strong>图 5 · 补偿层的价值先升后降。</strong>横轴是时间，也是一代代的模型；补偿层的净价值在交叉点之后变成负数。
  </figcaption>

  <svg
    class='aoa-life-svg'
    viewBox='0 0 600 330'
    role='img'
    aria-label='示意图：模型能力是一条持续上升的曲线；补偿层的净价值先上升，在模型较弱时让产品能用，之后下降，越过零线变成负数。'
  >
    <defs>
      <clipPath id='aoa-life-wipe'>
        <rect class='aoa-life-wipe' x='44' y='0' width='406' height='300'></rect>
      </clipPath>
      <clipPath id='aoa-life-above'>
        <rect x='50' y='0' width='400' height='200'></rect>
      </clipPath>
      <clipPath id='aoa-life-below'>
        <rect x='50' y='200' width='400' height='100'></rect>
      </clipPath>
    </defs>

    <path class='aoa-life-axis' d='M50,25 L50,290 L470,290'></path>
    <path class='aoa-life-zero' d='M50,200 L460,200'></path>
    <text class='aoa-life-muted aoa-life-sm' x='465' y='204'>0</text>

    <g clip-path='url(#aoa-life-wipe)'>
      <g clip-path='url(#aoa-life-above)'>
        <path
          class='aoa-life-gain'
          d='M50,200 C100,120 160,95 210,130 S330,230 440,262 L440,200 Z'
        ></path>
      </g>
      <g clip-path='url(#aoa-life-below)'>
        <path
          class='aoa-life-loss'
          d='M50,200 C100,120 160,95 210,130 S330,230 440,262 L440,200 Z'
        ></path>
      </g>
      <path class='aoa-life-model' d='M50,255 C200,240 320,150 440,48'></path>
      <path class='aoa-life-scaffold' d='M50,200 C100,120 160,95 210,130 S330,230 440,262'></path>
    </g>

    <g class='aoa-life-late' style='--at: 0.5s'>
      <text class='aoa-life-sm' x='96' y='82'>① 模型弱的时候</text>
      <text class='aoa-life-muted aoa-life-sm' x='96' y='99'>补偿层让产品能用</text>
    </g>

    <g class='aoa-life-late' style='--at: 1.05s'>
      <circle class='aoa-life-dot' cx='307' cy='200' r='5'></circle>
      <text class='aoa-life-accent aoa-life-sm' x='307' y='186' text-anchor='middle' font-weight='600'>② 交叉点：该删了</text>
    </g>

    <g class='aoa-life-late' style='--at: 1.45s'>
      <text class='aoa-life-danger aoa-life-sm' x='300' y='262' text-anchor='end'>③ 变成负担</text>
      <text class='aoa-life-muted aoa-life-sm' x='300' y='279' text-anchor='end'>限制模型、冲突、占上下文、要维护</text>
    </g>

    <g class='aoa-life-late' style='--at: 1.7s'>
      <text class='aoa-life-md' x='450' y='50' font-weight='600'>模型能力</text>
      <text class='aoa-life-md aoa-life-danger' x='450' y='258' font-weight='600'>补偿层</text>
      <text class='aoa-life-sm aoa-life-muted' x='450' y='276'>的净价值</text>
    </g>

    <text class='aoa-life-muted aoa-life-sm' x='470' y='310' text-anchor='end'>时间 / 模型代际 →</text>
  </svg>

  <p class='aoa-note'>
    概念示意图，不是实测数据。思路来自 Sutton 的 The Bitter Lesson、Hyung Won Chung 关于「结构多和结构少」的曲线，以及 Aaron
    Levie 说的「建脚手架、模型追上来、拆掉脚手架」。
  </p>
</figure>

<script>
  import { armReveal } from './reveal'

  armReveal('[data-aoa-life]', undefined, 0.45)
</script>

<style>
  .aoa-life-svg {
    display: block;
    width: 100%;
    max-width: 640px;
    height: auto;
    margin: 0 auto;
  }

  .aoa-life-svg text {
    font-family: inherit;
    fill: hsl(var(--foreground));
  }

  .aoa-life-svg .aoa-life-muted {
    fill: hsl(var(--muted-foreground));
  }

  .aoa-life-svg .aoa-life-accent {
    fill: hsl(var(--primary));
  }

  .aoa-life-svg .aoa-life-danger {
    fill: hsl(var(--destructive));
  }

  :global(.dark) .aoa-life-svg .aoa-life-danger {
    fill: hsl(0 70% 72%);
  }

  .aoa-life-sm {
    font-size: 12.5px;
  }

  .aoa-life-md {
    font-size: 14px;
  }

  .aoa-life-axis {
    fill: none;
    stroke: hsl(var(--border));
    stroke-width: 1.5;
  }

  .aoa-life-zero {
    fill: none;
    stroke: hsl(var(--muted-foreground) / 0.5);
    stroke-width: 1;
    stroke-dasharray: 4 4;
  }

  .aoa-life-model {
    fill: none;
    stroke: hsl(var(--foreground));
    stroke-width: 2.5;
    stroke-linecap: round;
  }

  .aoa-life-scaffold {
    fill: none;
    stroke: hsl(var(--primary));
    stroke-width: 2.5;
    stroke-linecap: round;
  }

  .aoa-life-gain {
    fill: hsl(var(--primary) / 0.14);
  }

  .aoa-life-loss {
    fill: hsl(var(--destructive) / 0.12);
  }

  :global(.dark) .aoa-life-loss {
    fill: hsl(0 70% 60% / 0.16);
  }

  .aoa-life-dot {
    fill: hsl(var(--background));
    stroke: hsl(var(--primary));
    stroke-width: 2;
  }

  /* ---------- 动效 ---------- */

  .aoa-life-wipe {
    transform-origin: 44px 0;
  }

  .aoa-armed .aoa-life-wipe {
    transform: scaleX(0);
  }

  .aoa-armed .aoa-life-late {
    opacity: 0;
  }

  .aoa-play .aoa-life-wipe {
    transition: transform 1.9s cubic-bezier(0.35, 0.1, 0.25, 1);
  }

  .aoa-play .aoa-life-late {
    transition: opacity 0.45s ease var(--at, 1.6s);
  }

  @media (max-width: 640px) {
    .aoa-life-sm {
      font-size: 17px;
    }

    .aoa-life-md {
      font-size: 19px;
    }
  }

  @media print {
    .aoa-armed .aoa-life-wipe {
      transform: none;
    }

    .aoa-armed .aoa-life-late {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .aoa-play .aoa-life-wipe,
    .aoa-play .aoa-life-late {
      transition: none;
    }
  }
</style>
