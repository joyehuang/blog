  <script is:inline>
    ;(() => {
      const promo = document.getElementById('jiajia-promo')
      const popout = document.getElementById('jiajia-popout')
      if (!popout) return

      const panel = popout.querySelector('[data-popout-panel]')
      const promoKey = 'joye-jiajia-promo-v3'
      const popoutKey = 'joye-jiajia-popout-state'
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      let nudgeTimer = 0
      let nudgeInterval = 0

      // 内置精选答案兜底 + 异步拉取全量 297+ 条答案目录，保证输入匹配与回车跳转同步零延迟。
      let answerCatalog = [
        {
          id: '3f1234d6-48cc-488b-b49d-9aec22950181',
          title: '多 Agent 协作与分工应该怎么设计',
          conclusion:
            '不要模仿人类职位或让多个 Agent 平级自由协作，应按上下文边界、权限立场和物理隔离切分，把子 Agent 当受控工具调用。',
          url: 'https://jiajia.fun/a/3f1234d6-48cc-488b-b49d-9aec22950181-%E5%A4%9Aagent%E5%8D%8F%E4%BD%9C%E4%B8%8E%E5%88%86%E5%B7%A5%E5%BA%94%E8%AF%A5%E6%80%8E%E4%B9%88%E8%AE%BE%E8%AE%A1'
        },
        {
          id: '200b404c-a49a-439b-9201-52314c3c59c6',
          title: '为何应让强模型自主决定写入记忆而非写死规则',
          conclusion:
            '对强模型预先写死记忆筛选规则反而压低性能；解决不可靠靠的是拿原始 transcript 核对重写，而非静态规则限制。',
          url: 'https://jiajia.fun/a/200b404c-a49a-439b-9201-52314c3c59c6-%E4%B8%BA%E4%BD%95%E5%BA%94%E8%AE%A9%E5%BC%BA%E6%A8%A1%E5%9E%8B%E8%87%AA%E4%B8%BB%E5%86%B3%E5%AE%9A%E5%86%99%E5%85%A5%E8%AE%B0%E5%BF%86%E8%80%8C%E9%9D%9E%E5%86%99%E6%AD%BB%E8%A7%84%E5%88%99'
        },
        {
          id: 'a2ce6b7c-1b1f-4cb2-9320-3a6903d4c930',
          title: '长期编程任务如何管理 Agent 上下文',
          conclusion:
            '以分层知识、可验证任务状态和按需历史检索重建上下文，让新会话低成本恢复工作，而不是反复搬运完整聊天记录。',
          url: 'https://jiajia.fun/a/a2ce6b7c-1b1f-4cb2-9320-3a6903d4c930-%E9%95%BF%E6%9C%9F%E7%BC%96%E7%A8%8B%E4%BB%BB%E5%8A%A1%E5%A6%82%E4%BD%95%E7%AE%A1%E7%90%86agent%E4%B8%8A%E4%B8%8B%E6%96%87'
        },
        {
          id: 'b685e4d5-b261-4021-915c-dae70e72a1b1',
          title: '如何把 Agent 评测包装进项目',
          conclusion:
            '从 20–50 条真实 badcase 起步，按任务集、判定器、可复现运行层和带 trace 的报告四要素分三层落地。',
          url: 'https://jiajia.fun/a/b685e4d5-b261-4021-915c-dae70e72a1b1-%E5%A6%82%E4%BD%95%E6%8A%8Aagent%E8%AF%84%E6%B5%8B%E5%8C%85%E8%A3%85%E8%BF%9B%E9%A1%B9%E7%9B%AE'
        },
        {
          id: '7acb496a-11b2-4150-b04b-1adbe3d834d3',
          title: 'Agent 的记忆模块怎么做',
          conclusion:
            '按会话上下文、近期问答带入、检索式长期记忆、群聊历史、顶层规则五层设计，核心是原文落盘加索引指针。',
          url: 'https://jiajia.fun/a/7acb496a-11b2-4150-b04b-1adbe3d834d3-agent%E7%9A%84%E8%AE%B0%E5%BF%86%E6%A8%A1%E5%9D%97%E6%80%8E%E4%B9%88%E5%81%9A'
        },
        {
          id: 'd49fe50e-dfd1-4968-b92f-5ed9078aee26',
          title: 'Skill 的定义、构建步骤与多 Agent 协调机制',
          conclusion:
            'Skill 是将做事流程文件化的经验资产；多 Agent 协调在工程上应采用“主从 + 文件契约”而非自由聊天。',
          url: 'https://jiajia.fun/a/d49fe50e-dfd1-4968-b92f-5ed9078aee26-skill%E7%9A%84%E5%AE%9A%E4%B9%89-%E6%9E%84%E5%BB%BA%E6%AD%A5%E9%AA%A4%E4%B8%8E%E5%A4%9Aagent%E5%8D%8F%E8%B0%83%E6%9C%BA%E5%88%B6'
        }
      ]

      let catalogLoaded = false
      const ensureCatalog = () => {
        if (catalogLoaded) return
        catalogLoaded = true
        fetch('/api/jiajia.json')
          .then((r) => (r.ok ? r.json() : null))
          .then((data) => {
            if (Array.isArray(data?.items) && data.items.length > 0) {
              answerCatalog = data.items
            }
          })
          .catch(() => {})
      }

      const STOP_TOKENS = new Set([
        '怎么',
        '如何',
        '什么',
        '哪些',
        '是否',
        '为何',
        '为什么',
        '是不是',
        '应该',
        '可以',
        '时候',
        '一个',
        '还是',
        '关于',
        '请问'
      ])

      const extractTokens = (text) => {
        const clean = text
          .toLowerCase()
          .replace(/[^\p{L}\p{N}]+/gu, ' ')
          .trim()
        const words = clean.split(/\s+/).filter(Boolean)
        const tokens = new Set()
        for (const w of words) {
          if (/^[a-z0-9]+$/.test(w)) {
            if (w.length >= 2) tokens.add(w)
          } else {
            const latin = w.match(/[a-z0-9]{2,}/g) || []
            latin.forEach((t) => tokens.add(t))
            const cjk = w.replace(/[a-z0-9]+/g, '')
            if (cjk.length === 1) tokens.add(cjk)
            for (let i = 0; i < cjk.length - 1; i++) {
              tokens.add(cjk.slice(i, i + 2))
            }
          }
        }
        return [...tokens]
      }

      const matchLocalAnswers = (query) => {
        const q = query.trim().toLowerCase()
        if (!q) return []
        const tokens = extractTokens(q)
        const scored = []
        for (const item of answerCatalog) {
          const title = (item.title || '').toLowerCase()
          const conclusion = (item.conclusion || '').toLowerCase()
          const topic = (item.topic || '').toLowerCase()
          let score = 0
          if (title.includes(q)) score += 45
          if (conclusion.includes(q)) score += 16
          for (const t of tokens) {
            const isStop = STOP_TOKENS.has(t)
            if (title.includes(t)) score += isStop ? 1 : t.length >= 3 ? 11 : 7
            if (conclusion.includes(t)) score += isStop ? 0.5 : 2.5
            if (topic.includes(t)) score += isStop ? 0 : 3
          }
          if (score >= 6) scored.push({ item, score })
        }
        return scored
          .sort((a, b) => b.score - a.score)
          .slice(0, 3)
          .map((s) => s.item)
      }

      const escapeHtml = (str) =>
        String(str || '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')

      const read = (key) => {
        try {
          return window.localStorage.getItem(key)
        } catch {
          return null
        }
      }
      const write = (key, value) => {
        try {
          window.localStorage.setItem(key, value)
        } catch {
          // ignore storage errors
        }
      }

      const nudge = () => {
        if (reduceMotion || popout.hidden || !panel || popout.matches(':focus-within')) return
        panel.classList.remove('jiajia-popout-nudge')
        void panel.offsetWidth
        panel.classList.add('jiajia-popout-nudge')
        window.setTimeout(() => panel.classList.remove('jiajia-popout-nudge'), 1600)
      }

      const scheduleNudge = () => {
        window.clearTimeout(nudgeTimer)
        window.clearInterval(nudgeInterval)
        if (reduceMotion || popout.hidden) return
        nudgeTimer = window.setTimeout(() => {
          nudge()
          nudgeInterval = window.setInterval(nudge, 24000)
        }, 10000)
      }

      const openPopout = () => {
        if (read(popoutKey) === 'closed') return
        popout.hidden = false
        ensureCatalog()
        scheduleNudge()
      }

      const closePopout = () => {
        popout.hidden = true
        write(popoutKey, 'closed')
        window.clearTimeout(nudgeTimer)
        window.clearInterval(nudgeInterval)
      }

      const closePromo = () => {
        if (!promo || promo.hidden) return
        promo.hidden = true
        document.documentElement.style.overflow = ''
        write(promoKey, String(Date.now()))
        openPopout()
      }

      const openPromo = () => {
        if (!promo) return openPopout()
        promo.hidden = false
        ensureCatalog()
        document.documentElement.style.overflow = 'hidden'
        const input = promo.querySelector('[data-promo-input]')
        if (input instanceof HTMLElement && window.matchMedia('(min-width: 640px)').matches) {
          input.focus()
        } else {
          promo.querySelector('[data-promo-dismiss]')?.focus()
        }
      }

      promo?.querySelectorAll('[data-promo-dismiss]').forEach((el) => {
        el.addEventListener('click', closePromo)
      })
      popout.querySelector('[data-popout-close]')?.addEventListener('click', closePopout)
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closePromo()
      })

      // 提问框与实时答案匹配：有匹配的群友问题时直接跳到该篇准确答案（/a/... 或 /qa/...），无匹配时跳去首页问夹夹。
      document.querySelectorAll('[data-jj-ask-form]').forEach((form) => {
        if (!(form instanceof HTMLFormElement)) return
        const input = form.querySelector('[data-jj-ask-input]')
        const host = form.closest('.jj')
        const matchesBox = host?.querySelector('[data-jj-matches]')
        const defaultStarters = host?.querySelector('[data-jj-default-starters]')
        const hintEl = form.querySelector('[data-jj-hint]')
        const surface = form.getAttribute('data-jj-surface') || 'home_popup'
        const dismissOnPick = form.hasAttribute('data-jj-dismiss-promo')
        let debounceId = 0

        const renderMatches = (query, items) => {
          const top = items[0]
          if (top?.url) {
            form.dataset.bestAnswerUrl = top.url
          } else {
            delete form.dataset.bestAnswerUrl
          }

          if (hintEl) {
            hintEl.textContent = top
              ? `已匹配到现成答案 · 按回车直达「${top.title.slice(0, 18)}…」`
              : query
                ? '还没有现成条目 · 按回车去 jiajia.fun 直接问夹夹'
                : '有群友问过会直接跳到那篇答案 · 回车直达'
          }

          if (!(matchesBox instanceof HTMLElement)) return
          if (!query) {
            matchesBox.hidden = true
            matchesBox.innerHTML = ''
            if (defaultStarters instanceof HTMLElement) defaultStarters.hidden = false
            return
          }

          if (defaultStarters instanceof HTMLElement) defaultStarters.hidden = true
          matchesBox.hidden = false

          const directAskUrl = `https://jiajia.fun/?${new URLSearchParams({ q: query }).toString()}`
          if (!items.length) {
            matchesBox.innerHTML = `<div class="jj-matches-empty"><a href="${escapeHtml(directAskUrl)}" target="_blank" rel="noopener noreferrer" class="jj-answer-link no-underline" data-jj-match-link data-analytics-event="project_link_click" data-analytics-surface="${escapeHtml(surface)}" data-analytics-section="product" data-analytics-project="jiajia" data-analytics-link-type="site"><span class="jj-answer-link-head"><span class="jj-answer-link-title">去 jiajia.fun 直接问夹夹：「${escapeHtml(query.slice(0, 28))}」</span><span class="jj-answer-link-badge">直接提问 ↗</span></span><span class="jj-answer-link-desc">夹夹会先翻群里公开讨论，再带着出处回答你</span></a></div>`
          } else {
            const rows = items
              .slice(0, surface === 'home_popout' ? 2 : 3)
              .map(
                (item, idx) =>
                  `<a href="${escapeHtml(item.url)}" target="_blank" rel="noopener noreferrer" class="jj-answer-link ${idx === 0 ? 'jj-answer-link-primary' : ''} no-underline" data-jj-match-link data-analytics-event="project_link_click" data-analytics-surface="${escapeHtml(surface)}" data-analytics-section="product" data-analytics-project="jiajia" data-analytics-link-type="site"><span class="jj-answer-link-head"><span class="jj-answer-link-title">${escapeHtml(item.title)}</span><span class="jj-answer-link-badge">${idx === 0 ? '回车直达答案 ↗' : '直达答案 ↗'}</span></span>${item.conclusion && surface !== 'home_popout' ? `<span class="jj-answer-link-desc">${escapeHtml(item.conclusion)}</span>` : ''}</a>`
              )
              .join('')
            matchesBox.innerHTML = `<div class="jj-matches-head">匹配到群友问过的准确答案：</div><div class="jj-starter-cards">${rows}</div>`
          }

          if (dismissOnPick) {
            matchesBox.querySelectorAll('[data-jj-match-link]').forEach((link) => {
              link.addEventListener('click', closePromo)
            })
          }
        }

        if (input instanceof HTMLInputElement && host instanceof HTMLElement) {
          input.addEventListener('focus', ensureCatalog)
          input.addEventListener('input', () => {
            ensureCatalog()
            const q = input.value.trim().slice(0, 120)
            if (q) host.setAttribute('data-jj-typing', 'true')
            else host.removeAttribute('data-jj-typing')

            const localHits = matchLocalAnswers(q)
            renderMatches(q, localHits)

            window.clearTimeout(debounceId)
            if (q.length >= 2) {
              debounceId = window.setTimeout(() => {
                fetch(`/api/jiajia.json?${new URLSearchParams({ q }).toString()}`)
                  .then((r) => (r.ok ? r.json() : null))
                  .then((data) => {
                    if (input.value.trim().slice(0, 120) !== q) return
                    const remote = Array.isArray(data?.items) ? data.items : []
                    const merged = [...localHits]
                    const seen = new Set(merged.map((x) => x.url))
                    for (const item of remote) {
                      if (item?.url && !seen.has(item.url)) {
                        seen.add(item.url)
                        merged.push(item)
                      }
                    }
                    renderMatches(q, merged.slice(0, 3))
                  })
                  .catch(() => {})
              }, 140)
            }
          })
        }

        form.addEventListener('submit', (event) => {
          event.preventDefault()
          const q = input instanceof HTMLInputElement ? input.value.trim().slice(0, 120) : ''
          const bestUrl = form.dataset.bestAnswerUrl || matchLocalAnswers(q)[0]?.url
          const targetUrl = bestUrl
            ? bestUrl
            : q
              ? `https://jiajia.fun/?${new URLSearchParams({ q }).toString()}`
              : 'https://jiajia.fun/'
          window.open(targetUrl, '_blank', 'noopener,noreferrer')
          if (dismissOnPick) {
            closePromo()
          }
        })
      })

      // 入场动画还在放的时候不要抢镜：等 Jojo 的开场放完再开始。
      const afterIntro = (run) => {
        const root = document.documentElement
        const jojoBusy = () =>
          ['armed', 'running'].includes(root.getAttribute('data-jojo-intro') || '')
        if (!jojoBusy()) return run()
        const observer = new MutationObserver(() => {
          if (jojoBusy()) return
          observer.disconnect()
          run()
        })
        observer.observe(root, { attributes: true, attributeFilter: ['data-jojo-intro'] })
      }

      afterIntro(() => {
        window.setTimeout(() => {
          // 首访弹一次大弹窗；看过的访客直接走 popout。
          if (read(promoKey)) openPopout()
          else openPromo()
        }, 900)
      })
    })()
  </script>
</PageLayout>

