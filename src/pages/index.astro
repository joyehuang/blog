---
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'
import { formatTalkDateCN, sortTalks } from '@/lib/talks'
import { renderJojoSvg } from '@jojo-web/static'
import avatar from 'src/assets/avatar.png'

import { Quote } from 'astro-pure/advanced'
import { PostPreview } from 'astro-pure/components/pages'
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import { Button, Card, Icon, Label } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import JiajiaMascot from '@/components/blog/JiajiaMascot.astro'
import LinkCard from '@/components/home/LinkCard.astro'
import Section from '@/components/home/Section.astro'
import SiteStats from '@/components/home/SiteStats.astro'
import SkillLayout from '@/components/home/SkillLayout.astro'
import JojoHero from '@/components/jojo/JojoHero'
import JojoIntro from '@/components/jojo/JojoIntro.astro'
import JoJo from '@/components/mascot/JoJo'
import Terminal from '@/components/terminal/Terminal.astro'
import config from '@/site-config'

export const prerender = true

// Jojo seat: the calm frame as build-time SVG; the engine loads only when it moves
const jojoSeatSvg = __JOJO__
  ? renderJojoSvg({
      idPrefix: 'seat-s',
      emotion: 'calm',
      size: 48,
      framing: 'tight',
      decorative: true
    })
  : ''

const jiajiaStarterAnswers = [
  {
    title: '多 Agent 协作与分工应该怎么设计',
    conclusion:
      '按上下文边界、权限立场和物理隔离切分，把子 Agent 当受控工具调用，而非平级自由聊天。',
    url: 'https://jiajia.fun/a/3f1234d6-48cc-488b-b49d-9aec22950181-%E5%A4%9Aagent%E5%8D%8F%E4%BD%9C%E4%B8%8E%E5%88%86%E5%B7%A5%E5%BA%94%E8%AF%A5%E6%80%8E%E4%B9%88%E8%AE%BE%E8%AE%A1'
  },
  {
    title: '为何应让强模型自主决定写入记忆而非写死规则',
    conclusion:
      '预先写死记忆筛选规则反而压低强模型性能；解决不可靠靠的是拿原始 transcript 核对重写。',
    url: 'https://jiajia.fun/a/200b404c-a49a-439b-9201-52314c3c59c6-%E4%B8%BA%E4%BD%95%E5%BA%94%E8%AE%A9%E5%BC%BA%E6%A8%A1%E5%9E%8B%E8%87%AA%E4%B8%BB%E5%86%B3%E5%AE%9A%E5%86%99%E5%85%A5%E8%AE%B0%E5%BF%86%E8%80%8C%E9%9D%9E%E5%86%99%E6%AD%BB%E8%A7%84%E5%88%99'
  },
  {
    title: '长期编程任务如何管理 Agent 上下文',
    conclusion: '以分层知识、可验证任务状态和按需历史检索重建上下文，而不是反复搬运完整聊天记录。',
    url: 'https://jiajia.fun/a/a2ce6b7c-1b1f-4cb2-9320-3a6903d4c930-%E9%95%BF%E6%9C%9F%E7%BC%96%E7%A8%8B%E4%BB%BB%E5%8A%A1%E5%A6%82%E4%BD%95%E7%AE%A1%E7%90%86agent%E4%B8%8A%E4%B8%8B%E6%96%87'
  },
  {
    title: '如何把 Agent 评测包装进项目',
    conclusion:
      '从 20–50 条真实 badcase 起步，按任务集、判定器、可复现运行层和带 trace 报告分三层落地。',
    url: 'https://jiajia.fun/a/b685e4d5-b261-4021-915c-dae70e72a1b1-%E5%A6%82%E4%BD%95%E6%8A%8Aagent%E8%AF%84%E6%B5%8B%E5%8C%85%E8%A3%85%E8%BF%9B%E9%A1%B9%E7%9B%AE'
  }
]

const languages = ['TypeScript', 'JavaScript', 'Python', 'SQL']
const frontend = ['React', 'Next.js', 'Tailwind CSS', 'Remotion', 'Vite']
const backend = ['Node.js', 'Vercel', 'Supabase', 'AWS', 'Stripe', 'Inngest']
const ai = [
  'Claude Code',
  'LLM',
  'Transformer',
  'Multi-Agent',
  'RAG',
  'Function Calling',
  'Prompt Engineering'
]
const tools = ['Cursor', 'Git', 'Docker', 'Bun', 'Figma', 'ESLint/Prettier']

const MAX_POSTS = 5
const allPosts = await getBlogCollection()
const allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS)

const openSourceRepos = [
  {
    name: 'Learn-Open-Harness',
    description: 'OpenHarness 零基础交互式教程 — Agent Loop、Tools、Memory、Multi-Agent',
    fallbackStars: 297
  },
  {
    name: 'minimind-notes',
    description: '从零构建 LLM — Transformer、Pretraining、SFT 的原理与对照实验',
    fallbackStars: 93
  }
]

async function fetchStars(repo: string, fallback: number) {
  try {
    const res = await fetch(`https://api.github.com/repos/joyehuang/${repo}`, {
      headers: { Accept: 'application/vnd.github+json' }
    })
    if (!res.ok) return fallback
    const data = (await res.json()) as { stargazers_count?: number }
    return data.stargazers_count ?? fallback
  } catch {
    return fallback
  }
}

const openSource = await Promise.all(
  openSourceRepos.map(async (r) => ({
    ...r,
    stars: await fetchStars(r.name, r.fallbackStars)
  }))
)

const MAX_NOTES = 4
const noteTypeLabels: Record<string, string> = {
  note: '笔记',
  snippet: '片段',
  draft: '草稿',
  idea: '想法',
  research: '研究',
  reference: '参考'
}
const allNotes = (await getCollection('notes')).filter((e) => !e.data.draft)
const latestNotes = allNotes
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, MAX_NOTES)

const talks = sortTalks(
  (await getCollection('talks')).filter((t) => !t.data.draft && t.data.status === 'published')
)
const latestTalk = talks[0]
---

<PageLayout meta={{ title: 'Home' }} highlightColor='#659EB9'>
  <JojoIntro />
  <main class='flex w-full flex-col items-center'>
    <section
      class='animate mb-10 flex flex-col items-center gap-y-7 relative z-50'
      id='content-header'
    >
      <div class='relative'>
        <Image
          src={avatar}
          alt='profile'
          data-intro-target='avatar'
          data-jojo-piece='avatar'
          class='h-28 w-auto rounded-full border p-1'
          loading='eager'
          fetchpriority='high'
          decoding='async'
        />
        {__JOJO__ && <JojoHero client:idle lang='zh' staticSvg={jojoSeatSvg} />}
      </div>

      <div class='flex flex-col items-center gap-y-4'>
        <h1 class='text-3xl font-bold' data-jojo-piece='name'>{config.author}</h1>
        <div class='flex flex-wrap justify-center gap-x-7 gap-y-3' data-jojo-piece='labels'>
          <Label title='Melbourne, Australia'>
            <Icon name='location' class='size-5' slot='icon' />
          </Label>
          <Label
            title='GitHub'
            as='a'
            href='https://github.com/joyehuang'
            target='_blank'
            data-analytics-event='github_link_click'
            data-analytics-surface='home_profile'
            data-analytics-target='profile'
          >
            <Icon name='github' class='size-5' slot='icon' />
          </Label>
        </div>
      </div>

      {/* Connect Me! */}
      <div class='flex flex-row gap-3' data-jojo-piece='connect'>
        <a
          href='/contact'
          class='flex flex-row items-center gap-x-3 rounded-full border bg-background px-4 py-2 text-sm shadow-sm transition-shadow hover:shadow-md'
        >
          <span class='relative flex items-center justify-center'>
            <span
              class='absolute size-2 animate-ping rounded-full border border-green-400 bg-green-400 opacity-75'
            ></span>
            <span class='size-2 rounded-full bg-green-400'></span>
          </span>
          <p class='font-medium text-muted-foreground'>Connect Me!</p>
        </a>
      </div>
    </section>

    <div
      id='content'
      class='animate relative z-0 flex w-full min-w-0 max-w-full flex-col gap-y-10 md:w-4/5 lg:w-5/6'
    >
      <div class='-mt-2' data-jojo-piece='card'>
        <Terminal />
      </div>
      <Section title='About' data-jojo-piece='about'>
        <p class='text-muted-foreground'>AI Agent & Full-Stack Developer</p>
        <p class='text-muted-foreground'>
          墨尔本大学在读，专注 AI Agent 产品开发 —— 从 Adastra Labs（石墨文档海外）的
          Playyy.ai、特赞 Tezign 的 atypica（商业研究 Multi-Agent），到 fAIshion.ai 与 Goshu Tech
          的全栈与剪辑 Agent，都是这条线上的实践。 在意 LLM 的底层机制，也在意产品能不能真正跑起来。
          Build fast, learn faster — 平时弹琴、拉大提琴、玩摄影。
        </p>
        <Button title='More about me' class='w-fit self-end' href='/about' style='ahead' />
      </Section>
      {/* 导流：另一个产品「夹夹 · Agent 工程踩坑问答」jiajia.fun */}
      <section
        id='product'
        aria-labelledby='product-heading'
        data-jojo-piece='product'
        data-jojo-stop='product'
      >
        <h2 id='product-heading' class='sr-only'>Product</h2>
        <div class='jj jiajia-card relative flex flex-col gap-4 p-5 sm:p-6'>
          <div class='flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between sm:gap-6'>
            <div class='relative min-w-0 flex-1'>
              <div class='flex flex-wrap items-center gap-1.5 text-xs'>
                <span class='jj-status'>
                  <span class='jj-coral-dot' aria-hidden='true'></span>
                  <span>jiajia.fun · 290+ 条真实问答</span>
                </span>
                <span class='jj-chip jj-chip-method'>
                  <span class='jj-chip-dot' aria-hidden='true'></span>上下文与记忆
                </span>
                <span class='jj-chip jj-chip-pick'>
                  <span class='jj-chip-dot' aria-hidden='true'></span>工具与选型
                </span>
                <span class='jj-chip jj-chip-concept'>
                  <span class='jj-chip-dot' aria-hidden='true'></span>架构与评测
                </span>
                <span class='jj-chip jj-chip-career'>
                  <span class='jj-chip-dot' aria-hidden='true'></span>求职与面试
                </span>
              </div>

              <div class='mt-3 flex items-center gap-3.5'>
                <JiajiaMascot id='home-filo' mood='happy' interactive size={50} />
                <div class='min-w-0'>
                  <a
                    href='https://jiajia.fun'
                    target='_blank'
                    rel='noopener noreferrer'
                    class='jj-title-link no-underline'
                    data-analytics-event='project_link_click'
                    data-analytics-surface='home_product'
                    data-analytics-section='product'
                    data-analytics-project='jiajia'
                    data-analytics-link-type='site'
                  >
                    <h3 class='jj-heading text-xl font-bold sm:text-2xl'>
                      夹夹 · Agent 工程踩坑问答
                    </h3>
                  </a>
                  <p class='jj-kicker text-xs'>做 Agent 卡住了？先问问我。</p>
                </div>
              </div>

              <p class='jj-body mt-2.5 text-sm leading-relaxed'>
                群里做 AI Agent 的工程师问过、答过、纠正过的真实问题，整理成可搜索的答案与专题目录
                —— 每一条结论都能直接回到原始讨论。
              </p>
            </div>

            <div class='jj-right relative flex shrink-0 flex-col items-start gap-2.5 sm:items-end'>
              <div class='jj-folder-preview hidden sm:flex' aria-hidden='true'>
                <span class='jj-md-card jj-md-card-1'>
                  <span class='jj-md-tag jj-chip-pick'>● 选型</span>
                  <span class='jj-md-code'>01.md</span>
                </span>
                <span class='jj-md-card jj-md-card-2'>
                  <span class='jj-md-tag jj-chip-method'>● 记忆</span>
                  <span class='jj-md-code'>02.md</span>
                </span>
              </div>
              <a
                href='https://jiajia.fun'
                target='_blank'
                rel='noopener noreferrer'
                class='jj-cta text-sm no-underline'
                data-analytics-event='project_link_click'
                data-analytics-surface='home_product'
                data-analytics-section='product'
                data-analytics-project='jiajia'
                data-analytics-link-type='site'
              >
                <span>去逛逛题库</span>
                <span class='jj-cta-circle' aria-hidden='true'>↗</span>
              </a>
            </div>
          </div>

          <form
            action='https://jiajia.fun/'
            method='get'
            target='_blank'
            data-jj-ask-form
            data-jj-surface='home_product'
            class='jj-ask-inline'
          >
            <span class='jj-ask-spark' aria-hidden='true'>✦</span>
            <input
              type='text'
              name='q'
              maxlength='120'
              autocomplete='off'
              enterkeyhint='send'
              placeholder='输入你的 Agent 问题（如：多 Agent 怎么分工 / 记忆怎么写），回车直达答案'
              aria-label='在博客直接向夹夹提问'
              class='jj-ask-input'
              data-jj-ask-input
            />
            <button
              type='submit'
              class='jj-send-circle'
              aria-label='直达夹夹答案或去问夹夹'
              data-analytics-event='project_link_click'
              data-analytics-surface='home_product'
              data-analytics-section='product'
              data-analytics-project='jiajia'
              data-analytics-link-type='site'
              data-analytics-target='ask_submit'
            >
              <svg
                xmlns='http://www.w3.org/2000/svg'
                width='16'
                height='16'
                viewBox='0 0 24 24'
                fill='none'
                stroke='currentColor'
                stroke-width='2.5'
                stroke-linecap='round'
                stroke-linejoin='round'
                aria-hidden='true'
              >
                <path d='m5 12 7-7 7 7'></path>
                <path d='M12 19V5'></path>
              </svg>
            </button>
          </form>

          <div class='jj-matches-box' data-jj-matches hidden></div>

          <div class='jj-starter-row' data-jj-default-starters>
            <span class='jj-starter-label'>群友问过（点击直达答案）：</span>
            {
              jiajiaStarterAnswers.map((item) => (
                <a
                  href={item.url}
                  target='_blank'
                  rel='noopener noreferrer'
                  class='jj-starter-pill no-underline'
                  title={item.conclusion}
                  data-analytics-event='project_link_click'
                  data-analytics-surface='home_product'
                  data-analytics-section='product'
                  data-analytics-project='jiajia'
                  data-analytics-link-type='site'
                >
                  <span>{item.title}</span>
                  <span class='jj-pill-arrow' aria-hidden='true'>
                    ↗
                  </span>
                </a>
              ))
            }
          </div>
        </div>
      </section>
      {
        allPostsByDate.length > 0 && (
          <Section title='Blog' data-jojo-stop='blog'>
            <ul class='flex flex-col gap-y-1.5 sm:gap-y-2'>
              {allPostsByDate.map((p) => (
                <li class='flex flex-col gap-x-2 sm:flex-row'>
                  <PostPreview post={p} />
                </li>
              ))}
            </ul>
            <Button title='More blogs' class='w-fit self-end' href='/blog' style='ahead' />
          </Section>
        )
      }

      {
        latestNotes.length > 0 && (
          <Section title='Notes' data-jojo-stop='notes'>
            <ul class='flex flex-col gap-y-1.5 sm:gap-y-2'>
              {latestNotes.map((note) => (
                <li class='post-preview group/card flex flex-col relative rounded-2xl border bg-background transition-colors ease-in-out px-5 py-2.5 hover:bg-muted'>
                  <a
                    class='group/link w-full flex flex-col sm:flex-row transition-all hover:text-primary'
                    href={`/notes/${note.id}`}
                    data-astro-prefetch
                  >
                    <span class='min-w-[95px] py-1 text-xs text-muted-foreground'>
                      {noteTypeLabels[note.data.type] || note.data.type}
                    </span>
                    <div class='z-10 flex-grow'>
                      <div class='flex justify-between'>
                        <div>{note.data.title}</div>
                        <svg
                          xmlns='http://www.w3.org/2000/svg'
                          width='16'
                          height='16'
                          viewBox='0 0 24 24'
                          fill='none'
                          stroke-width='2.5'
                          stroke-linecap='round'
                          stroke-linejoin='round'
                          class='my-1 stroke-muted-foreground group-hover/link:stroke-primary'
                        >
                          <line
                            x1='5'
                            y1='12'
                            x2='19'
                            y2='12'
                            class='translate-x-4 scale-x-0 transition-all duration-300 ease-in-out group-hover/link:translate-x-1 group-hover/link:scale-x-100'
                          />
                          <polyline
                            points='12 5 19 12 12 19'
                            class='translate-x-0 transition-all duration-300 ease-in-out group-hover/link:translate-x-1'
                          />
                        </svg>
                      </div>
                    </div>
                  </a>
                </li>
              ))}
            </ul>
            <Button title='More notes' class='w-fit self-end' href='/notes' style='ahead' />
          </Section>
        )
      }

      {
        latestTalk && (
          <Section title='Talks' data-jojo-stop='talks'>
            <p class='text-muted-foreground'>
              每周分享已改成
              <a
                href='https://space.bilibili.com/3546914882587480'
                target='_blank'
                rel='noopener noreferrer'
                class='underline underline-offset-4 hover:text-foreground'
              >
                B 站直播
              </a>
              ：更像线上自习室，一起写代码、读文档，随时提问。往期内容与幻灯片仍在这里。
            </p>
            <LinkCard
              heading={latestTalk.data.title}
              subheading={latestTalk.data.subtitle ?? ''}
              date={`最新一期 · ${formatTalkDateCN(latestTalk.data.date)}`}
              href='/talks'
              target='_self'
            />
            <Button title='全部分享' class='w-fit self-end' href='/talks' style='ahead' />
          </Section>
        )
      }

      <Section title='Experience' data-jojo-stop='experience'>
        <LinkCard
          heading='Adastra Labs（石墨文档海外）'
          subheading='AI 全栈工程师'
          href='https://playyy.ai/'
          data-analytics-event='project_link_click'
          data-analytics-surface='home_experience'
          data-analytics-section='experience'
          data-analytics-project='playyy'
          data-analytics-link-type='site'
        >
          <ul class='ms-4 list-disc text-muted-foreground'>
            <li>参与 Playyy.ai —— AI 图像生成与品牌设计平台的产品与工程研发</li>
          </ul>
        </LinkCard>
        <LinkCard
          heading='上海特赞 Tezign'
          subheading='AIGC 研发部门全栈实习生'
          href='https://atypica.ai/'
          data-analytics-event='project_link_click'
          data-analytics-surface='home_experience'
          data-analytics-section='experience'
          data-analytics-project='atypica'
          data-analytics-link-type='site'
        >
          <ul class='ms-4 list-disc text-muted-foreground'>
            <li>参与 atypica.ai —— 面向商业研究场景的 Multi-Agent 系统</li>
          </ul>
        </LinkCard>
        <LinkCard
          heading='AIXCut'
          subheading='AI 全栈研发'
          href='https://aixcut.cn/'
          data-analytics-event='project_link_click'
          data-analytics-surface='home_experience'
          data-analytics-section='experience'
          data-analytics-project='aixcut'
          data-analytics-link-type='site'
        >
          <ul class='ms-4 list-disc text-muted-foreground'>
            <li>参与 AI 视频剪辑 Agent 的设计与工程化落地</li>
          </ul>
        </LinkCard>
        <LinkCard
          heading='fAIshion.ai'
          subheading='AI 全栈工程师（远程）'
          href='https://www.faishion.ai/'
          data-analytics-event='project_link_click'
          data-analytics-surface='home_experience'
          data-analytics-section='experience'
          data-analytics-project='faishion'
          data-analytics-link-type='site'
        >
          <ul class='ms-4 list-disc text-muted-foreground'>
            <li>AI 虚拟试衣与服装搭配平台的全栈开发与模型集成</li>
          </ul>
        </LinkCard>
      </Section>
      <Section title='Open Source'>
        {
          openSource.map((repo) => (
            <LinkCard
              heading={repo.name}
              subheading={repo.description}
              date={`⭐ ${repo.stars}`}
              href={`https://github.com/joyehuang/${repo.name}`}
              data-analytics-event='github_link_click'
              data-analytics-surface='home_open_source'
              data-analytics-target='repo'
              data-analytics-repo={repo.name}
            />
          ))
        }
      </Section>
      <Section title='Education'>
        <Card
          as='a'
          heading='墨尔本大学'
          subheading='理学学士 - 计算与软件工程'
          date='2月 2024 - 6月 2027'
        />
      </Section>

      <Section title='Skills'>
        <SkillLayout title='Languages' skills={languages} />
        <SkillLayout title='Frontend' skills={frontend} />
        <SkillLayout title='Backend' skills={backend} />
        <SkillLayout title='AI & Agent' skills={ai} />
        <SkillLayout title='Tools' skills={tools} />
      </Section>

      <SiteStats />
    </div>
    <Quote class='mt-12' />
  </main>

  {
    /* JoJo ASCII mascot — floating companion bottom-right (hidden on mobile); replaced by the Jojo dock */
  }
  {
    !__JOJO__ && (
      <div id='home-jojo' class='pointer-events-none fixed bottom-6 end-6 z-40 hidden md:block'>
        <div class='pointer-events-auto'>
          <JoJo client:load size='md' quipPool='idle' />
        </div>
      </div>
    )
  }

  {
    /* 首访弹窗：夹夹（jiajia.fun）推广，localStorage 记住，每位访客弹一次。
       内嵌可直接输入的提问框，回车或点示例问题直接带问题跳往 jiajia.fun。 */
  }
  <div
    id='jiajia-promo'
