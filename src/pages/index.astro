---
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'
import { formatTalkDateCN, sortTalks } from '@/lib/talks'
import avatar from 'src/assets/avatar.png'

import { Quote } from 'astro-pure/advanced'
import { PostPreview } from 'astro-pure/components/pages'
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import { Button, Card, Icon, Label } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import LinkCard from '@/components/home/LinkCard.astro'
import Section from '@/components/home/Section.astro'
import SiteStats from '@/components/home/SiteStats.astro'
import SkillLayout from '@/components/home/SkillLayout.astro'
import LegacyIntroOverlay from '@/components/intro/LegacyIntroOverlay.astro'
import JoJo from '@/components/mascot/JoJo'
import Terminal from '@/components/terminal/Terminal.astro'
import config from '@/site-config'

export const prerender = true

const languages = ['TypeScript', 'JavaScript', 'Python', 'SQL']
const frontend = ['React', 'Next.js', 'Tailwind CSS', 'Remotion', 'Vite']
const backend = ['Node.js', 'Vercel', 'Supabase', 'AWS', 'Stripe', 'Inngest']
const ai = [
  'Claude Code',
  'LLM',
  'Transformer',
  'Multi-Agent',
  'RAG',
  'Function Calling',
  'Prompt Engineering'
]
const tools = ['Cursor', 'Git', 'Docker', 'Bun', 'Figma', 'ESLint/Prettier']

const MAX_POSTS = 5
const allPosts = await getBlogCollection()
const allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS)

const openSourceRepos = [
  {
    name: 'Learn-Open-Harness',
    description: 'OpenHarness 零基础交互式教程 — Agent Loop、Tools、Memory、Multi-Agent',
    fallbackStars: 297
  },
  {
    name: 'minimind-notes',
    description: '从零构建 LLM — Transformer、Pretraining、SFT 的原理与对照实验',
    fallbackStars: 93
  }
]

async function fetchStars(repo: string, fallback: number) {
  try {
    const res = await fetch(`https://api.github.com/repos/joyehuang/${repo}`, {
      headers: { Accept: 'application/vnd.github+json' }
    })
    if (!res.ok) return fallback
    const data = (await res.json()) as { stargazers_count?: number }
    return data.stargazers_count ?? fallback
  } catch {
    return fallback
  }
}

const openSource = await Promise.all(
  openSourceRepos.map(async (r) => ({
    ...r,
    stars: await fetchStars(r.name, r.fallbackStars)
  }))
)

const MAX_NOTES = 4
const noteTypeLabels: Record<string, string> = {
  note: '笔记',
  snippet: '片段',
  draft: '草稿',
  idea: '想法',
  research: '研究',
  reference: '参考'
}
const allNotes = (await getCollection('notes')).filter((e) => !e.data.draft)
const latestNotes = allNotes
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, MAX_NOTES)

const talks = sortTalks(
  (await getCollection('talks')).filter((t) => !t.data.draft && t.data.status === 'published')
)
const latestTalk = talks[0]
---

<PageLayout meta={{ title: 'Home' }} highlightColor='#659EB9'>
  <LegacyIntroOverlay />
  <main class='flex w-full flex-col items-center'>
    <section
      class='animate mb-10 flex flex-col items-center gap-y-7 relative z-50'
      id='content-header'
    >
      <Image
        src={avatar}
        alt='profile'
        data-intro-target='avatar'
        class='h-28 w-auto rounded-full border p-1'
        loading='eager'
      />

      <div class='flex flex-col items-center gap-y-4'>
        <h1 class='text-3xl font-bold'>{config.author}</h1>
        <div class='flex flex-wrap justify-center gap-x-7 gap-y-3'>
          <Label title='Melbourne, Australia'>
            <Icon name='location' class='size-5' slot='icon' />
          </Label>
          <Label
            title='GitHub'
            as='a'
            href='https://github.com/joyehuang'
            target='_blank'
            data-analytics-event='github_link_click'
            data-analytics-surface='home_profile'
            data-analytics-target='profile'
          >
            <Icon name='github' class='size-5' slot='icon' />
          </Label>
        </div>
      </div>

      {/* Connect Me! */}
      <div class='flex flex-row gap-3'>
        <a
          href='/contact'
          class='flex flex-row items-center gap-x-3 rounded-full border bg-background px-4 py-2 text-sm shadow-sm transition-shadow hover:shadow-md'
        >
          <span class='relative flex items-center justify-center'>
            <span
              class='absolute size-2 animate-ping rounded-full border border-green-400 bg-green-400 opacity-75'
            ></span>
            <span class='size-2 rounded-full bg-green-400'></span>
          </span>
          <p class='font-medium text-muted-foreground'>Connect Me!</p>
        </a>
      </div>
    </section>

    <div
      id='content'
      class='animate relative z-0 flex w-full min-w-0 max-w-full flex-col gap-y-10 md:w-4/5 lg:w-5/6'
    >
      <div class='-mt-2'>
        <Terminal />
      </div>
      <Section title='About'>
        <p class='text-muted-foreground'>AI Agent & Full-Stack Developer</p>
        <p class='text-muted-foreground'>
          墨尔本大学在读，专注 AI Agent 产品开发 —— 从 Adastra Labs（石墨文档海外）的
          Playyy.ai、特赞 Tezign 的 atypica（商业研究 Multi-Agent），到 fAIshion.ai 与 Goshu Tech
          的全栈与剪辑 Agent，都是这条线上的实践。 在意 LLM 的底层机制，也在意产品能不能真正跑起来。
          Build fast, learn faster — 平时弹琴、拉大提琴、玩摄影。
        </p>
        <Button title='More about me' class='w-fit self-end' href='/about' style='ahead' />
      </Section>
      {/* 导流：另一个产品「面试手记」joyehuang.dev */}
      <section id='product' aria-labelledby='product-heading'>
        <h2 id='product-heading' class='sr-only'>Product</h2>
        <a
          href='https://joyehuang.dev'
          target='_blank'
          rel='noopener noreferrer'
          class='hd interview-card group relative flex flex-col gap-3 p-5 no-underline sm:flex-row sm:items-center sm:justify-between sm:gap-6 sm:p-6'
          data-hd-frame
          data-analytics-event='project_link_click'
          data-analytics-surface='home_interview'
          data-analytics-section='interview'
          data-analytics-project='interview-notes'
          data-analytics-link-type='site'
        >
          {/* 手绘墨线边框：路径按卡片实际尺寸生成，进入视口时 draw-on */}
          <svg class='hd-frame' aria-hidden='true' focusable='false'>
            <path class='hd-frame-path' pathLength='1' d=''></path>
          </svg>

          <div class='relative min-w-0'>
            <div class='flex flex-wrap items-center gap-2 text-xs'>
              <span class='hd-badge'>新企划 · 即将上线</span>
              <span class='hd-sub'>joyehuang.dev · 现已开放预约</span>
            </div>
            <h3 class='hd-heading mt-2 text-2xl font-bold sm:text-3xl'>
              <span class='hd-marker'>
                面试手记
                <svg
                  class='hd-marker-svg'
                  viewBox='0 0 200 18'
                  preserveAspectRatio='none'
                  aria-hidden='true'
                  focusable='false'
                >
                  <path
                    class='hd-marker-path'
                    pathLength='1'
                    d='M3 12 C 48 5, 116 16, 197 7'
                    vector-effect='non-scaling-stroke'></path>
                </svg>
              </span>
            </h3>
            <p class='hd-body mt-2 text-sm leading-relaxed'>
              158 道真题一字不删，连答砸的都有 —— 逐字稿回放，看一场面试真实的样子
            </p>
          </div>

          <span class='hd-cta relative shrink-0 self-start text-sm sm:self-center'>
            去看看
            <span class='hd-arrow' aria-hidden='true'>→</span>
          </span>
        </a>
      </section>
      {
        allPostsByDate.length > 0 && (
          <Section title='Blog'>
            <ul class='flex flex-col gap-y-1.5 sm:gap-y-2'>
              {allPostsByDate.map((p) => (
                <li class='flex flex-col gap-x-2 sm:flex-row'>
                  <PostPreview post={p} />
                </li>
              ))}
            </ul>
            <Button title='More blogs' class='w-fit self-end' href='/blog' style='ahead' />
          </Section>
        )
      }

      {
        latestNotes.length > 0 && (
          <Section title='Notes'>
            <ul class='flex flex-col gap-y-1.5 sm:gap-y-2'>
              {latestNotes.map((note) => (
                <li class='post-preview group/card flex flex-col relative rounded-2xl border bg-background transition-colors ease-in-out px-5 py-2.5 hover:bg-muted'>
                  <a
                    class='group/link w-full flex flex-col sm:flex-row transition-all hover:text-primary'
                    href={`/notes/${note.id}`}
                    data-astro-prefetch
                  >
                    <span class='min-w-[95px] py-1 text-xs text-muted-foreground'>
                      {noteTypeLabels[note.data.type] || note.data.type}
                    </span>
                    <div class='z-10 flex-grow'>
                      <div class='flex justify-between'>
                        <div>{note.data.title}</div>
                        <svg
                          xmlns='http://www.w3.org/2000/svg'
                          width='16'
                          height='16'
                          viewBox='0 0 24 24'
                          fill='none'
                          stroke-width='2.5'
                          stroke-linecap='round'
                          stroke-linejoin='round'
                          class='my-1 stroke-muted-foreground group-hover/link:stroke-primary'
                        >
                          <line
                            x1='5'
                            y1='12'
                            x2='19'
                            y2='12'
                            class='translate-x-4 scale-x-0 transition-all duration-300 ease-in-out group-hover/link:translate-x-1 group-hover/link:scale-x-100'
                          />
                          <polyline
                            points='12 5 19 12 12 19'
                            class='translate-x-0 transition-all duration-300 ease-in-out group-hover/link:translate-x-1'
                          />
                        </svg>
                      </div>
                    </div>
                  </a>
                </li>
              ))}
            </ul>
            <Button title='More notes' class='w-fit self-end' href='/notes' style='ahead' />
          </Section>
        )
      }

      {
        latestTalk && (
          <Section title='Talks'>
            <p class='text-muted-foreground'>
              群里每周一次的线上交流会，轮流分享技术、求职和 AI 行业 ——
              每期的内容与幻灯片都公开沉淀在这里。
            </p>
            <LinkCard
              heading={latestTalk.data.title}
              subheading={latestTalk.data.subtitle ?? ''}
              date={`最新一期 · ${formatTalkDateCN(latestTalk.data.date)}`}
              href='/talks'
              target='_self'
            />
            <Button title='全部分享' class='w-fit self-end' href='/talks' style='ahead' />
          </Section>
        )
      }

      <Section title='Experience'>
        <LinkCard
          heading='Adastra Labs（石墨文档海外）'
          subheading='AI 全栈工程师'
          href='https://playyy.ai/'
          data-analytics-event='project_link_click'
          data-analytics-surface='home_experience'
          data-analytics-section='experience'
          data-analytics-project='playyy'
          data-analytics-link-type='site'
        >
          <ul class='ms-4 list-disc text-muted-foreground'>
            <li>参与 Playyy.ai —— AI 图像生成与品牌设计平台的产品与工程研发</li>
          </ul>
        </LinkCard>
        <LinkCard
          heading='上海特赞 Tezign'
          subheading='AIGC 研发部门全栈实习生'
          href='https://atypica.ai/'
          data-analytics-event='project_link_click'
          data-analytics-surface='home_experience'
          data-analytics-section='experience'
          data-analytics-project='atypica'
          data-analytics-link-type='site'
        >
          <ul class='ms-4 list-disc text-muted-foreground'>
            <li>参与 atypica.ai —— 面向商业研究场景的 Multi-Agent 系统</li>
          </ul>
        </LinkCard>
        <LinkCard
          heading='AIXCut'
          subheading='AI 全栈研发'
          href='https://aixcut.cn/'
          data-analytics-event='project_link_click'
          data-analytics-surface='home_experience'
          data-analytics-section='experience'
          data-analytics-project='aixcut'
          data-analytics-link-type='site'
        >
          <ul class='ms-4 list-disc text-muted-foreground'>
            <li>参与 AI 视频剪辑 Agent 的设计与工程化落地</li>
          </ul>
        </LinkCard>
        <LinkCard
          heading='fAIshion.ai'
          subheading='AI 全栈工程师（远程）'
          href='https://www.faishion.ai/'
          data-analytics-event='project_link_click'
          data-analytics-surface='home_experience'
          data-analytics-section='experience'
          data-analytics-project='faishion'
          data-analytics-link-type='site'
        >
          <ul class='ms-4 list-disc text-muted-foreground'>
            <li>AI 虚拟试衣与服装搭配平台的全栈开发与模型集成</li>
          </ul>
        </LinkCard>
      </Section>
      <Section title='Open Source'>
        {
          openSource.map((repo) => (
            <LinkCard
              heading={repo.name}
              subheading={repo.description}
              date={`⭐ ${repo.stars}`}
              href={`https://github.com/joyehuang/${repo.name}`}
              data-analytics-event='github_link_click'
              data-analytics-surface='home_open_source'
              data-analytics-target='repo'
              data-analytics-repo={repo.name}
            />
          ))
        }
      </Section>
      <Section title='Education'>
        <Card
          as='a'
          heading='墨尔本大学'
          subheading='理学学士 - 计算与软件工程'
          date='2月 2024 - 6月 2027'
        />
      </Section>

      <Section title='Skills'>
        <SkillLayout title='Languages' skills={languages} />
        <SkillLayout title='Frontend' skills={frontend} />
        <SkillLayout title='Backend' skills={backend} />
        <SkillLayout title='AI & Agent' skills={ai} />
        <SkillLayout title='Tools' skills={tools} />
      </Section>

      <SiteStats />
    </div>
    <Quote class='mt-12' />
  </main>

  {/* JoJo mascot — floating companion bottom-right (hidden on mobile) */}
  <div id='home-jojo' class='pointer-events-none fixed bottom-6 end-6 z-40 hidden md:block'>
    <div class='pointer-events-auto'>
      <JoJo client:load size='md' quipPool='idle' />
    </div>
  </div>

  {/* 首访弹窗：面试手记推广，localStorage 记住，每位访客只弹一次 */}
  <div
    id='interview-promo'
    class='interview-promo fixed inset-0 z-60 items-center justify-center p-4'
    hidden
  >
    <div class='interview-promo-backdrop absolute inset-0' data-promo-dismiss></div>
    <div
      class='hd hd-sheet interview-promo-card relative w-full max-w-md p-6'
      role='dialog'
      aria-modal='true'
      aria-labelledby='interview-promo-title'
    >
      <button
        type='button'
        data-promo-dismiss
        class='hd-close absolute end-3 top-3 flex size-8 items-center justify-center'
        aria-label='关闭弹窗'
      >
        <svg
          xmlns='http://www.w3.org/2000/svg'
          width='16'
          height='16'
          viewBox='0 0 24 24'
          fill='none'
          stroke='currentColor'
          stroke-width='2.5'
          stroke-linecap='round'
          stroke-linejoin='round'
          aria-hidden='true'
        >
          <path d='M18 6 6 18'></path>
          <path d='m6 6 12 12'></path>
        </svg>
      </button>

      <span class='hd-badge'>新企划 · 即将上线</span>
      <h2 id='interview-promo-title' class='hd-heading mt-3 text-3xl font-bold'>
        <span class='hd-marker'>
          面试手记
          <svg
            class='hd-marker-svg'
            viewBox='0 0 200 18'
            preserveAspectRatio='none'
            aria-hidden='true'
            focusable='false'
          >
            <path
              class='hd-marker-path'
              pathLength='1'
              d='M3 12 C 48 5, 116 16, 197 7'
              vector-effect='non-scaling-stroke'></path>
          </svg>
        </span>
      </h2>
      <p class='hd-body mt-3 text-sm leading-relaxed'>
        158 道真实面试题，一字不删 —— 连当场答砸的那些也原样留着。
      </p>
      <p class='hd-body mt-1 text-sm leading-relaxed'>
        逐字稿回放，看一场面试真实的样子，而不是事后美化过的复盘。
      </p>

      <div class='mt-5 flex flex-wrap items-center gap-3'>
        <a
          href='https://joyehuang.dev'
          target='_blank'
          rel='noopener noreferrer'
          class='hd-cta text-sm no-underline'
          data-promo-dismiss
          data-analytics-event='project_link_click'
          data-analytics-surface='home_popup'
          data-analytics-section='interview'
          data-analytics-project='interview-notes'
          data-analytics-link-type='site'
        >
          去看看
          <span class='hd-arrow' aria-hidden='true'>→</span>
        </a>
        <button type='button' data-promo-dismiss class='hd-quiet text-sm'>先不看</button>
      </div>
    </div>
  </div>

  {/* 左下角 popout：跟随原 SOA 的位置（右下角是 JoJo），关闭后 localStorage 记住 */}
  <aside
    id='interview-popout'
    class='fixed bottom-4 start-4 z-50 w-[270px] max-w-[calc(100vw-2rem)] md:bottom-6 md:start-6'
    aria-label='面试手记'
    hidden
  >
    <div data-popout-panel class='hd hd-sheet interview-popout-panel relative p-4'>
      <button
        type='button'
        data-popout-close
        class='hd-close absolute end-2 top-2 z-10 flex size-7 items-center justify-center'
        aria-label='关闭面试手记弹窗'
      >
        <svg
          xmlns='http://www.w3.org/2000/svg'
          width='16'
          height='16'
          viewBox='0 0 24 24'
          fill='none'
          stroke='currentColor'
          stroke-width='2.5'
          stroke-linecap='round'
          stroke-linejoin='round'
          aria-hidden='true'
        >
          <path d='M18 6 6 18'></path>
          <path d='m6 6 12 12'></path>
        </svg>
      </button>

      <div class='pe-7'>
        <span class='hd-badge'>即将上线</span>
        <h2 class='hd-heading mt-2 text-lg font-bold'>面试手记</h2>
        <p class='hd-body mt-1 text-xs leading-relaxed'>
          158 道真题一字不删，连答砸的都有 —— 逐字稿回放。
        </p>
        <a
          href='https://joyehuang.dev'
          target='_blank'
          rel='noopener noreferrer'
          class='hd-cta mt-3 text-xs no-underline'
          data-analytics-event='project_link_click'
          data-analytics-surface='home_popout'
          data-analytics-section='interview'
          data-analytics-project='interview-notes'
          data-analytics-link-type='site'
        >
          去看看
          <span class='hd-arrow' aria-hidden='true'>→</span>
        </a>
      </div>
    </div>
  </aside>

  <script is:inline>
    ;(() => {
      const promo = document.getElementById('interview-promo')
      const popout = document.getElementById('interview-popout')
      if (!promo || !popout) return

      const panel = popout.querySelector('[data-popout-panel]')
      const promoKey = 'joye-interview-promo-seen'
      const popoutKey = 'joye-interview-popout-state'
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      let nudgeTimer = 0
      let nudgeInterval = 0

      const read = (key) => {
        try {
          return window.localStorage.getItem(key)
        } catch (e) {
          return null
        }
      }
      const write = (key, value) => {
        try {
          window.localStorage.setItem(key, value)
        } catch (e) {}
      }

      const nudge = () => {
        if (reduceMotion || popout.hidden || !panel) return
        panel.classList.remove('interview-popout-nudge')
        void panel.offsetWidth
        panel.classList.add('interview-popout-nudge')
        window.setTimeout(() => panel.classList.remove('interview-popout-nudge'), 1600)
      }

      const scheduleNudge = () => {
        window.clearTimeout(nudgeTimer)
        window.clearInterval(nudgeInterval)
        if (reduceMotion || popout.hidden) return
        nudgeTimer = window.setTimeout(() => {
          nudge()
          nudgeInterval = window.setInterval(nudge, 24000)
        }, 10000)
      }

      const openPopout = () => {
        // 关过就永久不再弹（localStorage），不因刷新复活。
        if (read(popoutKey) === 'closed') return
        popout.hidden = false
        scheduleNudge()
      }

      const closePopout = () => {
        popout.hidden = true
        write(popoutKey, 'closed')
        window.clearTimeout(nudgeTimer)
        window.clearInterval(nudgeInterval)
      }

      const closePromo = () => {
        if (promo.hidden) return
        promo.hidden = true
        document.documentElement.style.overflow = ''
        write(promoKey, String(Date.now()))
        openPopout()
      }

      const openPromo = () => {
        promo.hidden = false
        document.documentElement.style.overflow = 'hidden'
        promo.querySelector('[data-promo-dismiss]')?.focus()
      }

      promo.querySelectorAll('[data-promo-dismiss]').forEach((el) => {
        el.addEventListener('click', closePromo)
      })
      popout.querySelector('[data-popout-close]')?.addEventListener('click', closePopout)
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closePromo()
      })

      // 入场动画还在放的时候不要抢镜：等 intro overlay 落到静止态再开始。
      const afterIntro = (run) => {
        const overlay = document.getElementById('intro-overlay')
        if (!overlay) return run()
        const settled = () =>
          overlay.classList.contains('intro-idle') || overlay.classList.contains('intro-done')
        if (settled()) return run()
        const observer = new MutationObserver(() => {
          if (!settled()) return
          observer.disconnect()
          run()
        })
        observer.observe(overlay, { attributes: true, attributeFilter: ['class'] })
      }

      afterIntro(() => {
        window.setTimeout(() => {
          // 首访弹一次大弹窗；看过的访客直接走 popout。
          if (read(promoKey)) openPopout()
          else openPromo()
        }, 900)
      })

      // ---- 手绘墨线边框：按卡片实际尺寸生成路径，进入视口时画出来 ----
      const card = document.querySelector('[data-hd-frame]')
      if (!card) return
      const svg = card.querySelector('.hd-frame')
      const path = svg && svg.querySelector('.hd-frame-path')
      if (!svg || !path) return

      // 手绘感的圆角矩形：四角半径不等（呼应 sk-1 的 255/15/225/15 走势），
      // 直边中点带 1.5px 抖动，看起来像一笔画歪的框。
      const framePath = (w, h) => {
        const inset = 1
        const x0 = inset
        const y0 = inset
        const x1 = w - inset
        const y1 = h - inset
        const cap = Math.max(6, Math.min(28, (Math.min(w, h) - 2 * inset) / 2.2))
        const tl = cap
        const tr = Math.max(6, cap * 0.3)
        const br = cap * 0.85
        const bl = Math.max(6, cap * 0.3)
        const wob = 1.5
        return [
          `M ${x0 + tl} ${y0}`,
          `Q ${(x0 + x1) / 2} ${y0 - wob} ${x1 - tr} ${y0}`,
          `Q ${x1} ${y0} ${x1} ${y0 + tr}`,
          `Q ${x1 + wob} ${(y0 + y1) / 2} ${x1} ${y1 - br}`,
          `Q ${x1} ${y1} ${x1 - br} ${y1}`,
          `Q ${(x0 + x1) / 2} ${y1 + wob} ${x0 + bl} ${y1}`,
          `Q ${x0} ${y1} ${x0} ${y1 - bl}`,
          `Q ${x0 - wob} ${(y0 + y1) / 2} ${x0} ${y0 + tl}`,
          `Q ${x0} ${y0} ${x0 + tl} ${y0}`,
          'Z'
        ].join(' ')
      }

      const drawFrame = () => {
        const rect = card.getBoundingClientRect()
        const w = Math.round(rect.width)
        const h = Math.round(rect.height)
        if (!w || !h) return
        svg.setAttribute('viewBox', '0 0 ' + w + ' ' + h)
        path.setAttribute('d', framePath(w, h))
      }

      drawFrame()
      if (window.ResizeObserver) new ResizeObserver(drawFrame).observe(card)
      else window.addEventListener('resize', drawFrame)

      if (window.IntersectionObserver) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return
              card.classList.add('is-drawn')
              io.disconnect()
            })
          },
          { threshold: 0.25 }
        )
        io.observe(card)
      } else {
        card.classList.add('is-drawn')
      }
    })()
  </script>
</PageLayout>

<style>
  /* 手绘推广层：joyehuang.dev 的设计语言（handdrawn-ui skill），
     只作用于这三个推广面（横幅卡 / 首访弹窗 / 左下 popout），
     用局部 --hd-* token，不碰站点的语义 token —— 页面其余部分保持原样。
     该设计系统只有亮色版，所以这三张「纸」在暗色下依然是纸。 */
  .hd {
    --hd-paper: #fffdf8;
    --hd-ink: #3a3a3a;
    --hd-sub: #5a564c;
    --hd-weak: #8d887c;
    --hd-hairline: #d8d2c2;
    --hd-yellow: #ffe08a;
    --hd-yellow2: #fff3b0;
    --hd-shadow: rgba(58, 58, 58, 0.18);
    --hd-ease: cubic-bezier(0.2, 0.7, 0.3, 1);
    color: var(--hd-ink);
    background-color: var(--hd-paper);
    /* 点阵纸面，低强度 */
    background-image: radial-gradient(circle, rgba(30, 30, 30, 0.05) 1.1px, transparent 1.1px);
    background-size: 22px 22px;
  }

  :global(.dark) .hd {
    /* 暗色下保持亮卡，只把硬阴影压深，让纸片从暗背景里立起来 */
    --hd-shadow: rgba(0, 0, 0, 0.55);
  }

  /* ---------- 横幅卡：SVG 墨线边框 + draw-on ---------- */
  .interview-card {
    isolation: isolate;
    border-radius: 28px 8px 24px 8px;
    box-shadow: 3px 3px 0 var(--hd-shadow);
    transition:
      transform 0.13s var(--hd-ease),
      box-shadow 0.13s var(--hd-ease);
  }

  .interview-card:hover,
  .interview-card:focus-visible {
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 var(--hd-shadow);
  }

  .hd-frame {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .hd-frame-path {
    fill: none;
    stroke: var(--hd-ink);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  .interview-card.is-drawn .hd-frame-path {
    animation: hd-draw 0.9s var(--hd-ease) both;
  }

  /* ---------- 弹窗 / popout 的纸片 ---------- */
  .hd-sheet {
    border: 2px solid var(--hd-ink);
    box-shadow: 3px 3px 0 var(--hd-shadow);
  }

  .interview-promo-card {
    /* sk-2 的不规则圆角 */
    border-radius: 15px 225px 15px 255px / 255px 15px 225px 15px;
    animation: hd-rise 0.4s var(--hd-ease) both;
  }

  .interview-popout-panel {
    /* sk-3 的不规则圆角 + 便利贴式微旋转 */
    border-radius: 225px 15px 255px 15px / 15px 255px 15px 225px;
    transform: rotate(-1deg);
    transform-origin: bottom left;
    animation: hd-rise 0.5s var(--hd-ease) both;
  }

  /* ---------- 排版原语 ---------- */
  .hd-heading {
    color: var(--hd-ink);
    line-height: 1.25;
  }

  .hd-body {
    color: var(--hd-sub);
  }

  .hd-sub {
    color: var(--hd-weak);
  }

  .hd-badge {
    display: inline-block;
    border: 2px solid var(--hd-ink);
    border-radius: 9999px;
    background-color: var(--hd-yellow);
    padding: 0.1rem 0.6rem;
    color: var(--hd-ink);
    font-size: 0.75rem;
    font-weight: 600;
    transform: rotate(-1.5deg);
  }

  /* 马克笔下划线：粗黄笔压在文字底层 */
  .hd-marker {
    position: relative;
    isolation: isolate;
    display: inline-block;
  }

  .hd-marker-svg {
    position: absolute;
    inset-inline: -0.35rem;
    bottom: 0.05em;
    z-index: -1;
    width: calc(100% + 0.7rem);
    height: 0.55em;
    overflow: visible;
  }

  .hd-marker-path {
    fill: none;
    stroke: var(--hd-yellow);
    stroke-width: 15;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    mix-blend-mode: multiply;
    animation: hd-draw 0.7s 0.35s ease-out both;
  }

  .interview-card .hd-marker-path {
    animation: none;
  }

  .interview-card.is-drawn .hd-marker-path {
    animation: hd-draw 0.7s 0.45s ease-out both;
  }

  /* ---------- 按钮 ---------- */
  .hd-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 2px solid var(--hd-ink);
    border-radius: 9999px;
    background-color: var(--hd-paper);
    box-shadow: 3px 3px 0 var(--hd-shadow);
    padding: 0.4rem 0.9rem;
    color: var(--hd-ink);
    font-weight: 600;
    transition:
      transform 0.13s var(--hd-ease),
      box-shadow 0.13s var(--hd-ease),
      background-color 0.13s var(--hd-ease);
  }

  .interview-card:hover .hd-cta,
  .interview-card:focus-visible .hd-cta,
  .hd-cta:hover {
    background-color: var(--hd-yellow2);
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 var(--hd-shadow);
  }

  .hd-cta:active {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0 var(--hd-shadow);
  }

  .hd-arrow {
    transition: transform 0.13s var(--hd-ease);
  }

  .interview-card:hover .hd-arrow,
  .interview-card:focus-visible .hd-arrow,
  .hd-cta:hover .hd-arrow {
    transform: translateX(3px);
  }

  .hd-close {
    border-radius: 9999px;
    color: var(--hd-weak);
    transition: color 0.13s var(--hd-ease);
  }

  .hd-close:hover {
    color: var(--hd-ink);
  }

  .hd-quiet {
    color: var(--hd-weak);
    text-decoration: underline;
    text-decoration-style: dashed;
    text-underline-offset: 4px;
  }

  .hd-quiet:hover {
    color: var(--hd-ink);
  }

  /* ---------- 首访弹窗容器（遮罩保持原来的语义 token 写法） ---------- */
  .interview-promo {
    display: flex;
  }

  .interview-promo[hidden] {
    display: none;
  }

  .interview-promo-backdrop {
    background-color: hsl(var(--background) / 0.72);
    background-image: linear-gradient(hsl(var(--foreground) / 0.12), hsl(var(--foreground) / 0.12));
    backdrop-filter: blur(6px);
    animation: hd-fade-in 0.25s ease both;
  }

  .interview-popout-nudge {
    animation: hd-nudge 1400ms var(--hd-ease);
  }

  @keyframes hd-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes hd-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes hd-fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes hd-nudge {
    0%,
    100% {
      transform: rotate(-1deg) translateY(0);
    }
    22% {
      transform: rotate(-1deg) translateY(7px);
    }
    48% {
      transform: rotate(-1deg) translateY(-11px);
    }
    72% {
      transform: rotate(-1deg) translateY(4px);
    }
    88% {
      transform: rotate(-1deg) translateY(-2px);
    }
  }

  /* popout 自带 rotate，入场动画要连同 rotate 一起做，否则会先正过来再转回去 */
  .interview-popout-panel {
    animation-name: hd-rise-tilt;
  }

  @keyframes hd-rise-tilt {
    from {
      opacity: 0;
      transform: rotate(-1deg) translateY(14px);
    }
    to {
      opacity: 1;
      transform: rotate(-1deg) translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .interview-promo-backdrop,
    .interview-promo-card,
    .interview-popout-panel,
    .interview-popout-nudge {
      animation: none;
    }

    .hd-frame-path,
    .hd-marker-path,
    .interview-card.is-drawn .hd-frame-path,
    .interview-card.is-drawn .hd-marker-path {
      animation: none;
      stroke-dashoffset: 0;
    }

    .interview-card,
    .hd-cta,
    .hd-arrow,
    .hd-close {
      transition: none;
    }

    .interview-card:hover,
    .interview-card:focus-visible,
    .hd-cta:hover,
    .interview-card:hover .hd-cta {
      transform: none;
    }

    .interview-card:hover .hd-arrow,
    .interview-card:focus-visible .hd-arrow,
    .hd-cta:hover .hd-arrow {
      transform: none;
    }
  }
</style>
