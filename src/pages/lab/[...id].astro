---
/**
 * Lab detail — /lab/<id>
 * Readable column for the write-up; the demo (rendered by the entry's MDX via
 * <DemoFrame>) breaks out wider than the text column.
 */
import { getCollection, render, type CollectionEntry } from 'astro:content'

import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import PageInfo from '@/components/comment/PageInfo.astro'
import JsonLd from '@/components/JsonLd.astro'
import { labCategoryLabels } from '@/lib/lab'

export const prerender = true

export async function getStaticPaths() {
  // Filter drafts here too, so a draft entry has no directly-reachable detail
  // page (the index already hides them).
  const entries = await getCollection('lab', ({ data }) => !data.draft)
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry }
  }))
}

type Props = {
  entry: CollectionEntry<'lab'>
}

const { entry } = Astro.props
const { Content } = await render(entry)

const { title, blurb, date, updatedDate, category, tags, source } = entry.data

const meta = {
  title,
  description: blurb
}

// Structured data: BlogPosting + breadcrumbs (author/publisher reference the
// site-wide Person emitted in BaseHead).
const origin = Astro.site!.origin
const pageUrl = new URL(Astro.url.pathname, Astro.site).href
const labLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${pageUrl}#article`,
  mainEntityOfPage: pageUrl,
  headline: title,
  description: blurb,
  inLanguage: 'zh-CN',
  datePublished: date.toISOString(),
  dateModified: (updatedDate ?? date).toISOString(),
  ...(tags.length ? { keywords: tags } : {}),
  author: { '@id': `${origin}/#person` },
  publisher: { '@id': `${origin}/#person` },
  isPartOf: { '@id': `${origin}/#website` }
}
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: `${origin}/` },
    { '@type': 'ListItem', position: 2, name: 'Lab', item: `${origin}/lab` },
    { '@type': 'ListItem', position: 3, name: title }
  ]
}
---

<PageLayout {meta}>
  <JsonLd schema={[labLd, breadcrumbLd]} />
  <Button title='Back' href='/lab' style='back' />

  <main class='mt-6 lg:mt-10'>
    <div class='mx-auto max-w-3xl'>
      <header class='animate'>
        <div class='mb-3 flex flex-wrap items-center gap-2 text-sm text-muted-foreground'>
          <span class='rounded-md bg-muted px-2 py-1 text-xs font-medium'>
            {labCategoryLabels.zh[category] ?? category}
          </span>
          {
            tags.length > 0 &&
              tags.map((tag) => (
                <span class='rounded-md border border-border px-2 py-1 text-xs'>{tag}</span>
              ))
          }
        </div>

        <h1 class='text-3xl font-medium leading-tight sm:text-4xl'>{title}</h1>

        <p class='mt-4 text-lg text-muted-foreground'>{blurb}</p>

        <div class='mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-muted-foreground'>
          <time datetime={date.toISOString()}>
            {date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
          {
            updatedDate && (
              <span>
                更新于{' '}
                {updatedDate.toLocaleDateString('zh-CN', { month: 'long', day: 'numeric' })}
              </span>
            )
          }
          {
            source && (
              <a
                href={source}
                target='_blank'
                rel='noopener noreferrer'
                class='transition-colors hover:text-primary hover:underline'
              >
                来源 ↗
              </a>
            )
          }
        </div>

        <PageInfo class='mt-3 italic' path={`/lab/${entry.id}`} hideComment />
      </header>
    </div>

    <article class='prose prose-pure dark:prose-invert animate mx-auto mt-8 max-w-3xl'>
      <Content />
    </article>

    <div class='animate mx-auto mt-10 max-w-3xl border-t border-border pt-6'>
      <Button title='← 返回 Lab' href='/lab' style='back' />
    </div>
  </main>
</PageLayout>
