---
/**
 * Lab index — /lab
 * A gallery of small frontend demos & tips. Each entry is a self-contained
 * showcase (usually a React island) with a short write-up on the detail page.
 */
import type { GetStaticPaths, Page } from 'astro'
import { getCollection } from 'astro:content'

import { Paginator } from 'astro-pure/components/pages'
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import PageInfo from '@/components/comment/PageInfo.astro'
import LabCard from '@/components/lab/LabCard.astro'
import { sortLabEntries, type LabEntry } from '@/lib/lab'

export const prerender = true

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const entries = sortLabEntries((await getCollection('lab')).filter((entry) => !entry.data.draft))
  return paginate(entries, { pageSize: 12 })
}

interface Props {
  page: Page<LabEntry>
}

const { page } = Astro.props as unknown as Props

const meta = {
  title: page.currentPage === 1 ? 'Lab' : `Lab - Page ${page.currentPage}`,
  description: '前端展示与小 tips：把平时积累的排版、布局、动效、交互技巧，做成可交互的小样。'
}

const paginationProps = {
  ...(page.url.prev && { prevUrl: { text: '← 上一页', url: page.url.prev } }),
  ...(page.url.next && { nextUrl: { text: '下一页 →', url: page.url.next } })
}
---

<PageLayout {meta}>
  <Button title='Back' href='/' style='back' />

  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <div class='mb-3 flex items-center gap-3'>
        <div class='rounded-lg bg-muted/50 p-3'>
          <span class='text-2xl'>🧪</span>
        </div>
        <div>
          <h1 class='text-3xl font-medium'>Lab</h1>
          <p class='text-sm text-muted-foreground'>前端小样 · 边做边记</p>
        </div>
      </div>
      <p class='max-w-3xl text-muted-foreground'>
        平时积累的前端展示和小 tips——排版、布局、动效、交互里那些“其实可以更好”的小技巧，
        每条都做成一个可交互的小样，配一段为什么。
      </p>
      <PageInfo class='mt-3 italic' path='/lab' hideComment />
    </div>

    {
      page.data.length === 0 ? (
        <p class='mt-8 text-muted-foreground'>还没有小样，很快就有。</p>
      ) : (
        <section id='content' class='animate mt-10' aria-label='Lab entries'>
          <div class='mb-5 text-sm text-muted-foreground'>共 {page.total} 个小样</div>

          <ul class='grid list-none grid-cols-1 gap-5 p-0 sm:grid-cols-2'>
            {page.data.map((entry) => (
              <li class='h-full'>
                <LabCard entry={entry} lang='zh' />
              </li>
            ))}
          </ul>

          {page.lastPage > 1 && (
            <div class='mt-8'>
              <Paginator {...paginationProps} />
            </div>
          )}
        </section>
      )
    }
  </main>
</PageLayout>
