---
import { activity } from '@/data/agent-teams'

import qqGroup from '@/assets/qq-group-contact.jpg'
---

<div class='soa-registration mt-4' data-soa-registration data-closed='false'>
  <p class='text-sm font-medium'>
    <time datetime='2026-09-30T23:59:00+08:00'>9月30日23:59截止（北京时间）</time>
  </p>
  <div class='mt-4 flex flex-wrap items-center gap-3'>
    <button
      type='button'
      class='soa-cta rounded-md bg-primary px-4 py-2.5 text-sm font-medium text-primary-foreground hover:text-primary-foreground focus-visible:text-primary-foreground'
      data-soa-cta
      aria-expanded='false'
      aria-controls='soa-qq-group'
      data-analytics-event='soa_registration_intent'
      data-analytics-surface='soa_registration'
      data-analytics-action='join_group'
      data-analytics-target='qq_group'
    >
      <span class='state-stack'
        ><span data-open-state>进粉丝群报名</span><span data-closed-state>进群查询登记</span></span
      >
    </button>
    <span class='text-sm text-muted-foreground'
      >QQ群 <span class='text-foreground'>831907794</span></span
    >
    <button
      type='button'
      class='soa-text-button text-sm text-primary underline underline-offset-4'
      data-soa-copy='831907794'
      data-analytics-event='soa_registration_intent'
      data-analytics-surface='soa_registration'
      data-analytics-action='copy'
      data-analytics-target='qq_group'>复制群号</button
    >
  </div>
  <div id='soa-qq-group' class='soa-panel' inert>
    <div class='soa-panel-inner'>
      <div class='pt-4'>
        <p class='text-sm text-muted-foreground'>
          用 QQ 扫码入群；入群答题：博客最新一篇文章的标题。
        </p>
        <img
          src={qqGroup.src}
          width={qqGroup.width}
          height={qqGroup.height}
          class='mt-3 h-auto max-w-full rounded-lg'
          style='width: 240px'
          alt='原 QQ 粉丝群 831907794 加群二维码'
          loading='lazy'
        />
      </div>
    </div>
  </div>
  <div class='mt-5 rounded-lg border bg-muted p-4'>
    <p class='state-stack text-sm text-muted-foreground' data-soa-status aria-live='polite'>
      <span data-open-state>截止前，在群里 @bot 发送：</span>
      <span data-closed-state>报名已截止，仍可在群里查询登记。</span>
    </p>
    <div class='mt-2 flex flex-wrap items-center justify-between gap-2'>
      <p class='break-words text-base' data-soa-example>我要报名SOA owner/repo</p>
      <button
        type='button'
        class='soa-copy rounded-md border bg-card px-3 py-2 text-sm'
        data-soa-copy='我要报名SOA owner/repo'
        data-soa-registration-copy
        data-analytics-event='soa_registration_intent'
        data-analytics-surface='soa_registration'
        data-analytics-action='copy'
        data-analytics-target='registration_example'>复制示例</button
      >
    </div>
    <p class='mt-2 text-sm text-muted-foreground'>
      将 owner/repo 换成你的公开仓库，以 bot 返回报名编号为准。
    </p>
  </div>
  <div
    class='soa-feedback text-sm text-muted-foreground'
    data-feedback='idle'
    role='status'
    aria-live='polite'
  >
    <span data-feedback-state='group' aria-hidden='true'>群号已复制。</span>
    <span data-feedback-state='example' aria-hidden='true'>示例已复制，请替换 owner/repo。</span>
    <span data-feedback-state='error' aria-hidden='true'>复制失败，请选中上方文字手动复制。</span>
  </div>
  <button
    type='button'
    class='soa-text-button text-sm text-muted-foreground underline underline-offset-4'
    data-soa-help
    aria-expanded='false'
    aria-controls='soa-help'>报名帮助：查询、更新与未收到确认</button
  >
  <div id='soa-help' class='soa-panel' inert>
    <div class='soa-panel-inner'>
      <div class='space-y-2 pt-3 text-sm leading-relaxed text-muted-foreground'>
        <p>查询或未收到确认：@bot 发送「查询我的SOA报名」，先确认本人登记。</p>
        <p>
          截止前更新：@bot 发送「更新我的SOA报名 owner/repo」。截止后停止新报名与修改，仍可查询。
        </p>
        <p>仅支持公开 GitHub 仓库。仅分享 repo 不会自动报名；登记仓库不代表作品已完成。</p>
        <a
          class='inline-block text-primary underline underline-offset-4'
          href={activity.docHref}
          target='_blank'
          rel='noopener noreferrer'>历史活动介绍 ↗</a
        >
      </div>
    </div>
  </div>
</div>

<script>
  import { isCompetitionClosed } from '@/data/agent-teams'

  function initSoaRegistration() {
    const root = document.querySelector<HTMLElement>('[data-soa-registration]')
    if (!root || root.dataset.ready) return
    root.dataset.ready = 'true'
    let previousClosed: boolean | undefined
    const refresh = () => {
      const closed = isCompetitionClosed()
      if (closed === previousClosed) return
      previousClosed = closed
      root.dataset.closed = String(closed)
      root
        .querySelectorAll<HTMLElement>('[data-open-state]')
        .forEach((el) => el.setAttribute('aria-hidden', String(closed)))
      root
        .querySelectorAll<HTMLElement>('[data-closed-state]')
        .forEach((el) => el.setAttribute('aria-hidden', String(!closed)))
      const copy = root.querySelector<HTMLButtonElement>('[data-soa-registration-copy]')!
      copy.disabled = closed
      copy.setAttribute('aria-disabled', String(closed))
    }
    refresh()
    const timer = window.setInterval(refresh, 1000)
    document.addEventListener('astro:before-swap', () => clearInterval(timer), { once: true })
    for (const selector of ['[data-soa-cta]', '[data-soa-help]']) {
      const button = root.querySelector<HTMLButtonElement>(selector)!
      const panel = root.querySelector<HTMLElement>(`#${button.getAttribute('aria-controls')}`)!
      button.addEventListener('click', () => {
        const open = button.getAttribute('aria-expanded') !== 'true'
        button.setAttribute('aria-expanded', String(open))
        panel.dataset.open = String(open)
        panel.inert = !open
      })
    }
    root.querySelectorAll<HTMLButtonElement>('[data-soa-copy]').forEach((button) => {
      button.addEventListener('click', async () => {
        const feedback = root.querySelector<HTMLElement>('[data-feedback]')!
        let state = 'error'
        try {
          await navigator.clipboard.writeText(button.dataset.soaCopy!)
          state = button.hasAttribute('data-soa-registration-copy') ? 'example' : 'group'
        } catch {
          /* Keep the visible fixed text available for manual copying. */
        }
        feedback.dataset.feedback = state
        feedback
          .querySelectorAll<HTMLElement>('[data-feedback-state]')
          .forEach((el) =>
            el.setAttribute('aria-hidden', String(el.dataset.feedbackState !== state))
          )
      })
    })
  }
  initSoaRegistration()
  document.addEventListener('astro:page-load', initSoaRegistration)
</script>

<style>
  .soa-registration {
    max-width: 42rem;
  }
  .soa-cta,
  .soa-copy,
  .soa-text-button {
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }
  .soa-cta:hover {
    background: hsl(var(--primary) / 0.9);
    color: hsl(var(--primary-foreground));
  }
  .soa-copy:hover {
    background: hsl(var(--background));
  }
  button:focus-visible {
    outline: 2px solid hsl(var(--ring));
    outline-offset: 3px;
  }
  button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .state-stack {
    display: grid;
  }
  .state-stack > span {
    grid-area: 1 / 1;
    transition:
      opacity 0.25s ease,
      filter 0.25s ease,
      transform 0.25s ease;
  }
  [data-closed-state],
  [data-closed='true'] [data-open-state] {
    opacity: 0;
    filter: blur(4px);
    transform: scale(0.6);
    pointer-events: none;
  }
  [data-closed='true'] [data-closed-state] {
    opacity: 1;
    filter: blur(0);
    transform: scale(1);
  }
  .soa-panel {
    display: grid;
    grid-template-rows: 0fr;
    visibility: hidden;
    opacity: 0;
    transition:
      grid-template-rows 0.25s ease,
      opacity 0.25s ease,
      visibility 0.25s ease;
  }
  .soa-panel[data-open='true'] {
    grid-template-rows: 1fr;
    visibility: visible;
    opacity: 1;
  }
  .soa-panel-inner {
    min-height: 0;
    overflow: hidden;
  }
  .soa-feedback {
    display: grid;
    margin: 0.5rem 0;
    min-height: 1.25rem;
  }
  .soa-feedback > span {
    grid-area: 1 / 1;
    opacity: 0;
    filter: blur(4px);
    transform: scale(0.6);
    transition:
      opacity 0.25s ease,
      filter 0.25s ease,
      transform 0.25s ease;
  }
  [data-feedback='group'] [data-feedback-state='group'],
  [data-feedback='example'] [data-feedback-state='example'],
  [data-feedback='error'] [data-feedback-state='error'] {
    opacity: 1;
    filter: blur(0);
    transform: scale(1);
  }
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      transition: none !important;
      animation: none !important;
    }
  }
</style>
