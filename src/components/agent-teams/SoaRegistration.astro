---
import { activity } from '@/data/agent-teams'

import qqGroup from '@/assets/qq-group-contact.jpg'
---

<div class='soa-registration mt-4' data-soa-registration>
  <p class='text-sm font-medium text-primary' data-soa-status>
    报名期限：2026 年 9 月 30 日 23:59（北京时间）
  </p>
  <div class='mt-3 flex flex-wrap items-center gap-3'>
    <a
      href='#soa-qq-group'
      class='rounded-lg border bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:text-primary-foreground focus-visible:text-primary-foreground'
      data-soa-cta
      data-analytics-event='soa_registration_intent'
      data-analytics-surface='soa_registration'
      data-analytics-action='join_group'
      data-analytics-target='qq_group'>进粉丝群查看 bot 报名说明</a
    >
    <span class='text-sm'>群号 <strong>831907794</strong></span>
    <button
      type='button'
      class='rounded-md border px-3 py-2 text-sm'
      data-soa-copy='831907794'
      data-analytics-event='soa_registration_intent'
      data-analytics-surface='soa_registration'
      data-analytics-action='copy'
      data-analytics-target='qq_group'>复制群号</button
    >
  </div>
  <p class='mt-3 text-sm leading-relaxed text-muted-foreground'>
    本届延期至 <time datetime={activity.competitionClosesAt}
      >2026 年 9 月 30 日 23:59（北京时间，UTC+8）</time
    >。 到达 10 月 1 日 00:00 后停止新报名与修改，仍可查询本人登记。
  </p>
  <ol class='mt-3 list-decimal space-y-2 pl-5 text-sm leading-relaxed'>
    <li>加入原粉丝群 <strong>831907794</strong>（入群答题：博客最新一篇文章的标题）。</li>
    <li>截止前在群里 @bot，发送明确报名句与公开可访问的 GitHub 仓库。</li>
    <li>以 bot 返回<strong>报名编号</strong>为成功；失败或未确认时，先查询本人登记。</li>
  </ol>
  <div class='mt-3 rounded-lg border bg-muted p-3 text-sm'>
    <p>报名示例（请将 owner/repo 替换为自己的仓库）：</p>
    <p class='mt-2 break-words' data-soa-example>我要报名SOA owner/repo</p>
    <p class='mt-1 break-words'>也可发送：我要报名SOA https://github.com/owner/repo</p>
    <button
      type='button'
      class='mt-2 rounded-md border px-3 py-2'
      data-soa-copy='我要报名SOA owner/repo'
      data-soa-registration-copy
      data-analytics-event='soa_registration_intent'
      data-analytics-surface='soa_registration'
      data-analytics-action='copy'
      data-analytics-target='registration_example'>复制报名示例</button
    >
    <p class='mt-2'>查询：@bot 发送「查询我的SOA报名」。</p>
    <p class='mt-1'>截止前更新：@bot 发送「更新我的SOA报名 owner/repo」。</p>
  </div>
  <p class='mt-2 text-sm text-muted-foreground'>
    只需公开 GitHub 仓库，无需网站表单、团队信息或 OAuth。仅分享 repo
    不会自动报名，必须明确报名；登记仓库不代表作品已完成。
  </p>
  <p class='mt-2 text-sm' role='status' aria-live='polite' data-soa-copy-status></p>
  <details id='soa-qq-group' class='mt-3 rounded-lg border p-3'>
    <summary class='cursor-pointer text-sm font-medium'>原粉丝群二维码 · 831907794</summary>
    <img
      src={qqGroup.src}
      width={qqGroup.width}
      height={qqGroup.height}
      style='width: 280px; height: auto'
      class='mt-3 h-auto max-w-full rounded-lg object-contain'
      alt='原 QQ 粉丝群 831907794 加群二维码'
      loading='lazy'
    />
  </details>
  <p class='mt-4 text-sm leading-relaxed text-muted-foreground'>
    页面展示原网站队伍；QQ 新报名暂不自动出现在此列表。旧网站组队入口已于 2026 年 7 月 10
    日关闭，历史队伍、名单与仓库链接保留。QQ 查询无记录不代表旧网站未报名，无需因此重复报名。
  </p>
  <a
    class='mt-2 inline-block text-sm underline underline-offset-4'
    href={activity.docHref}
    target='_blank'
    rel='noopener noreferrer'>历史活动介绍 ↗（旧组队说明以本页 QQ 直报规则为准）</a
  >
</div>

<script>
  import { competitionStatus, isCompetitionClosed } from '@/data/agent-teams'

  function initSoaRegistration() {
    const root = document.querySelector<HTMLElement>('[data-soa-registration]')
    if (!root || root.dataset.ready) return
    root.dataset.ready = 'true'
    const refresh = () => {
      const status = competitionStatus()
      root.querySelector('[data-soa-status]')!.textContent = status.label
      root.querySelector('[data-soa-cta]')!.textContent = status.cta
      const copy = root.querySelector<HTMLButtonElement>('[data-soa-registration-copy]')!
      copy.disabled = isCompetitionClosed()
      copy.setAttribute('aria-disabled', String(copy.disabled))
    }
    refresh()
    const timer = window.setInterval(refresh, 1000)
    document.addEventListener('astro:before-swap', () => clearInterval(timer), { once: true })
    root.querySelector('[data-soa-cta]')?.addEventListener('click', () => {
      root.querySelector<HTMLDetailsElement>('details')!.open = true
    })
    root.querySelectorAll<HTMLButtonElement>('[data-soa-copy]').forEach((button) => {
      button.addEventListener('click', async () => {
        const feedback = root.querySelector<HTMLElement>('[data-soa-copy-status]')!
        try {
          await navigator.clipboard.writeText(button.dataset.soaCopy!)
          feedback.textContent = '已复制；报名示例中的 owner/repo 请替换为自己的仓库。'
        } catch {
          feedback.textContent = '复制失败，请选中上方文字手动复制。'
        }
      })
    })
  }
  initSoaRegistration()
  document.addEventListener('astro:page-load', initSoaRegistration)
</script>

<style>
  ol {
    list-style-type: decimal;
  }
  button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
</style>
