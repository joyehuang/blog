---
interface Props {
  class?: string
  lang?: 'zh' | 'en'
  label?: string
  prefix?: string
  suffix?: string
}

const {
  class: className,
  lang = 'zh',
  label,
  prefix = 'joye',
  suffix = '050604'
} = Astro.props

const copy = {
  zh: { label: '微信号', hint: '悬停或聚焦显示' },
  en: { label: 'WeChat ID', hint: 'hover or focus to reveal' }
}[lang]

const text = label ?? copy.label
const ariaLabel = lang === 'zh' ? `${text}，${copy.hint}` : `${text}, ${copy.hint}`
---

<span
  class:list={['wechat-reveal', className]}
  tabindex='0'
  data-label={text}
  data-a={prefix}
  data-b={suffix}
  data-analytics-reveal-event='article_contact_reveal'
  data-analytics-surface='article_inline'
  data-analytics-method-name='wechat'
  data-analytics-action='reveal'
  aria-label={ariaLabel}></span>

<style>
  .wechat-reveal {
    position: relative;
    display: inline-grid;
    place-items: center;
    min-width: 6.8em;
    min-height: 1.45em;
    margin-inline: 0.1em;
    padding: 0.02em 0.5em;
    border: 1px solid hsl(var(--border));
    border-radius: 999px;
    background: hsl(var(--muted) / 0.22);
    color: hsl(var(--muted-foreground));
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', monospace;
    font-size: 0.92em;
    line-height: 1;
    vertical-align: 0.05em;
    cursor: pointer;
    user-select: none;
    transition:
      background-color 160ms ease,
      border-color 160ms ease,
      color 160ms ease;
  }

  .wechat-reveal::before {
    content: attr(data-label);
    transition:
      opacity 140ms ease,
      transform 140ms ease;
  }

  .wechat-reveal:hover,
  .wechat-reveal:focus {
    color: hsl(var(--foreground));
    border-color: hsl(var(--primary) / 0.45);
    background: hsl(var(--muted) / 0.5);
    outline: 2px solid hsl(var(--primary) / 0.22);
    outline-offset: 2px;
  }

  .wechat-reveal:hover::before,
  .wechat-reveal:focus::before {
    content: attr(data-a) attr(data-b);
  }
</style>
