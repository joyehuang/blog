function renderScoped(targetMood: NonNullable<Props['mood']>, scopeKey: string) {
  return RAW_SVGS[targetMood]
    .replaceAll('jojo-_R_0_', `jj-${scopeKey}`)
    .replace(
      'width="64" height="64"',
      `width="${size}" height="${size}" aria-hidden="true" focusable="false"`
    )
}

const primarySvg = renderScoped(mood, `${id}-a`)
const activeSvg = interactive ? renderScoped('curious', `${id}-b`) : ''
---

<span
  class:list={['jj-mascot', interactive && 'jj-mascot-interactive', className]}
  style={`--jj-mascot-size:${size}px`}
  role={title ? 'img' : undefined}
  aria-label={title}
  aria-hidden={title ? undefined : 'true'}
>
  <span class='jj-mascot-layer jj-mascot-rest' set:html={primarySvg} />
  {interactive && <span class='jj-mascot-layer jj-mascot-active' set:html={activeSvg} />}
</span>

<style is:global>
  .jj-mascot {
    position: relative;
    display: inline-flex;
    width: var(--jj-mascot-size, 48px);
    height: var(--jj-mascot-size, 48px);
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    line-height: 0;
    user-select: none;
  }

  .jj-mascot-layer {
    display: inline-flex;
    width: 100%;
    height: 100%;
    transition:
      opacity 180ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .jj-mascot-layer > svg {
    width: 100%;
    height: 100%;
    overflow: visible;
    display: block;
  }

  .jj-mascot-interactive .jj-mascot-active {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(0.94) rotate(-3deg);
    pointer-events: none;
  }

  .jj:hover .jj-mascot-interactive .jj-mascot-rest,
  .jj:focus-within .jj-mascot-interactive .jj-mascot-rest,
  .jj[data-jj-typing='true'] .jj-mascot-interactive .jj-mascot-rest {
    opacity: 0;
    transform: scale(0.94);
  }

  .jj:hover .jj-mascot-interactive .jj-mascot-active,
  .jj:focus-within .jj-mascot-interactive .jj-mascot-active,
  .jj[data-jj-typing='true'] .jj-mascot-interactive .jj-mascot-active {
    opacity: 1;
    transform: scale(1.04) rotate(0deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .jj-mascot-layer {
      transition: none;
    }
  }
</style>
