---
/**
 * TL;DR block for the top of a blog post.
 *
 * Usage (mdx):
 *   <TldrCard>
 *     - point one
 *     - point two
 *   </TldrCard>
 *
 * Quiet, editorial: a muted fill with a hairline border, no shadow, no
 * accent gradient, body font only (see DESIGN.md → Overview, Typography).
 * The slot is a markdown list; the post's prose list styling applies.
 */
interface Props {
  label?: string
}

const { label = 'TL;DR' } = Astro.props
---

<aside class='tldr not-prose my-8 rounded-lg border bg-muted/40 px-5 py-4 sm:px-6' aria-label={label}>
  <p class='m-0 text-xs font-medium uppercase tracking-wider text-muted-foreground'>{label}</p>
  <div class='tldr-body mt-2 text-[0.95rem] leading-relaxed text-foreground'>
    <slot />
  </div>
</aside>

<style>
  .tldr-body :global(ul) {
    margin: 0;
    padding-left: 1.1rem;
    list-style: disc;
  }

  .tldr-body :global(li) {
    margin: 0.4rem 0;
  }

  .tldr-body :global(li::marker) {
    color: hsl(var(--muted-foreground));
  }

  .tldr-body :global(p) {
    margin: 0;
  }

  .tldr-body :global(strong) {
    font-weight: 600;
  }
</style>
