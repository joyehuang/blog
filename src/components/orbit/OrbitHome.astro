---
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'
import avatar from 'src/assets/avatar.png'

import '@fontsource-variable/geist'

interface Props {
  locale?: 'zh' | 'en'
}
const { locale = 'zh' } = Astro.props
const en = locale === 'en'
const p = en ? '/en' : ''
const t = (zh: string, english: string) => (en ? english : zh)
const allPosts = en ? await getCollection('blogEn') : await getCollection('blog')
const posts = allPosts
  .filter((x) => !x.data.draft && (!en || x.data.translationKey))
  .sort(
    (a, b) =>
      +(b.data.updatedDate ?? b.data.publishDate) - +(a.data.updatedDate ?? a.data.publishDate)
  )
  .slice(0, 4)
const allNotes = en ? await getCollection('notesEn') : await getCollection('notes')
const notes = allNotes
  .filter((x) => !x.data.draft && (!en || x.data.translationKey))
  .sort((a, b) => +b.data.date - +a.data.date)
  .slice(0, 3)
const talks = (await getCollection('talks'))
  .filter((x) => !x.data.draft && x.data.status === 'published')
  .sort((a, b) => +b.data.date - +a.data.date)
const projects = [
  {
    name: 'Learn-Open-Harness',
    tag: 'OPEN SOURCE / AGENT SYSTEMS',
    type: 'harness',
    image: '',
    href: 'https://github.com/joyehuang/Learn-Open-Harness',
    description: t(
      '从零拆解 Agent 的运行机制：循环、工具、记忆与多智能体协作。',
      'Agent loops, tools, memory, and multi-agent collaboration — built from first principles.'
    ),
    role: t('独立开源项目', 'Independent open source')
  },
  {
    name: 'Playyy.ai',
    tag: 'PRODUCT / GENERATIVE AI',
    type: 'image',
    image: '/images/landing/playyy-ui-light.webp',
    href: 'https://playyy.ai/',
    description: t(
      '在 Adastra Labs 参与 AI 图像生成与品牌设计平台的产品和工程研发。',
      'Product and engineering for an AI image generation and brand design platform at Adastra Labs.'
    ),
    role: t('Adastra Labs · AI 全栈工程师', 'Adastra Labs · AI full-stack engineer')
  },
  {
    name: 'atypica.ai',
    tag: 'PRODUCT / MULTI-AGENT',
    type: 'image',
    image: '/images/landing/atypica-site-light.webp',
    href: 'https://atypica.ai/',
    description: t(
      '在特赞参与商业研究 Multi-Agent 系统，让研究从问题走向洞察。',
      'A multi-agent system for commercial research, built with the AIGC team at Tezign.'
    ),
    role: t('特赞 Tezign · 全栈实习生', 'Tezign · Full-stack intern')
  },
  {
    name: 'AIXCut',
    tag: 'PRODUCT / VIDEO AGENT',
    type: 'image',
    image: '/images/landing/aixcut-site-light.webp',
    href: 'https://aixcut.cn/',
    description: t(
      '参与 AI 视频剪辑 Agent 的设计与工程化落地。',
      'Designing and shipping an AI video-editing agent.'
    ),
    role: t('AI 全栈研发', 'AI full-stack engineer')
  },
  {
    name: 'minimind-notes',
    tag: 'OPEN SOURCE / LLM',
    type: 'model',
    image: '',
    href: 'https://github.com/joyehuang/minimind-notes',
    description: t(
      '从 Transformer 到预训练与 SFT，用原理与对照实验重新理解语言模型。',
      'Understanding language models through Transformer, pretraining, SFT, and controlled experiments.'
    ),
    role: t('独立开源项目', 'Independent open source')
  }
]
---

<div class='orbit-home' data-orbit-home data-palette='acid'>
  <a class='skip' href='#writing'>{t('跳转到正文', 'Skip to content')}</a>
  <header class='orbit-nav'>
    <a class='wordmark' href={p || '/'} aria-label='Joye home'>joye<span>®</span></a>
    <nav aria-label={t('主导航', 'Main navigation')}>
      <a href='#work'>{t('作品', 'Work')}</a><a href='#writing'>{t('文字', 'Writing')}</a><a
        href='#about'>{t('关于', 'About')}</a
      >
    </nav>
    <div class='nav-end'>
      <a class='language' href={en ? '/' : '/en'}>{en ? '中文' : 'EN'}</a><a
        class='contact-link'
        href={`${p}/contact`}>{t('聊聊想法', 'Let’s talk')} <span>↗</span></a
      >
    </div>
  </header>
  <main>
    <section class='hero' id='work' aria-labelledby='hero-title'>
      <div class='hero-topline'>
        <span><i></i> JOYE HUANG / {t('开发者 · 探索者', 'DEVELOPER · EXPLORER')}</span><span
          >MELBOURNE, AU <span class='local-time'></span></span
        >
      </div>
      <div class='hero-heading'>
        <h1 id='hero-title'>Ideas into<br /><span>something real.</span><sup>↗</sup></h1><div
          class='hero-intro'
        >
          <span class='tiny-label'>AI AGENT & FULL-STACK DEVELOPER</span><p>
            {
              t(
                '在意智能的底层机制，\n也在意想法真正运行的那一刻。',
                'Curious about how intelligence works.\nDriven to make ideas work in the real world.'
              )
            }
          </p><a href='#writing'
            >{t('我的构建与思考', 'Things I build. Things I learn.')} <span>↓</span></a
          >
        </div>
      </div>
      <div class='exhibit-header'>
        <span class='tiny-label'>EXPERIMENTS IN ORBIT <span class='muted'>/ 01—05</span></span><div
          class='palette-controls'
          role='group'
          aria-label={t('切换配色', 'Color palette')}
        >
          <button
            data-color='acid'
            aria-label={t('荧光绿', 'Acid green')}
            aria-pressed='true'
            style='--swatch:#c5ff61'></button><button
            data-color='ice'
            aria-label={t('冰蓝', 'Ice blue')}
            aria-pressed='false'
            style='--swatch:#91caff'></button><button
            data-color='rose'
            aria-label={t('粉红', 'Rose')}
            aria-pressed='false'
            style='--swatch:#ffa6ce'></button>
        </div>
      </div>
      <div
        class='orbit-stage'
        tabindex='0'
        role='region'
        aria-roledescription='carousel'
        aria-label={t(
          '3D 作品展台，拖动或按左右方向键切换',
          '3D project gallery. Drag or use left and right arrow keys.'
        )}
      >
        <div class='stage-grid' aria-hidden='true'></div><div
          class='stage-coordinate'
          aria-hidden='true'
        >
          Y<br />│<br />└── X
        </div>
        <div class='orbit-track'>
          {
            projects.map((project, i) => (
              <button
                class:list={['project-object', i === 0 && 'is-active']}
                data-project={i}
                aria-label={`${t('查看', 'View')} ${project.name}`}
                aria-pressed={i === 0}
                style={`--offset:${i};transform:translate3d(${Math.sin(i * 1.1) * 510}px,${Math.abs(i) * 12}px,${(Math.cos(i * 1.1) - 1) * 430}px) rotateY(${-i * 22}deg)`}
              >
                <div class='object-top'>
                  <>
                    <span class='object-dots'>● ● ●</span>
                    <span>{String(i + 1).padStart(2, '0')} / JOYE.LAB</span>
                    <span>↗</span>
                  </>
                </div>
                <>
                  <div class={`object-preview ${project.type}`}>
                    {project.image ? (
                      <img
                        src={project.image}
                        alt={`${project.name} ${t('产品界面', 'product interface')}`}
                        loading={i < 2 ? 'eager' : 'lazy'}
                        draggable='false'
                        width='760'
                        height='480'
                      />
                    ) : project.type === 'harness' ? (
                      <div class='harness-interface'>
                        <span class='terminal-caption'>~/learn-open-harness</span>
                        <div class='terminal-title'>
                          Small loop.
                          <br />
                          <em>Infinite possibility.</em>
                        </div>
                        <div class='node-flow'>
                          <span>THINK</span>
                          <b>→</b>
                          <span>ACT</span>
                          <b>→</b>
                          <span>OBSERVE</span>
                        </div>
                        <div class='terminal-status'>
                          <i /> agent.loop <span>running_</span>
                        </div>
                      </div>
                    ) : (
                      <div class='model-interface'>
                        <span>TRANSFORMER / FROM SCRATCH</span>
                        <div class='model-title'>
                          Less magic.
                          <br />
                          <em>More understanding.</em>
                        </div>
                        <div class='model-layers'>
                          {['EMBEDDING', 'ATTENTION', 'FEED FORWARD'].map((x, i) => (
                            <div style={`--layer:${i}`}>
                              {x}
                              <span>↗</span>
                            </div>
                          ))}
                        </div>
                        <span>PRETRAIN → SFT → EXPERIMENT</span>
                      </div>
                    )}
                  </div>
                  <div class='object-bottom'>
                    <>
                      <span>{project.name}</span>
                      <span>{project.tag.split(' / ')[0]}</span>
                    </>
                  </div>
                </>
              </button>
            ))
          }
        </div>
        <div class='drag-hint'>
          <span>↔</span>
          {t('拖动探索 · 点击选择', 'DRAG TO EXPLORE · CLICK TO SELECT')}
        </div>
      </div>
      <div class='exhibit-footer'>
        <div class='selected-project' aria-live='polite' aria-atomic='true'>
          <span class='selected-count tiny-label'>01 / 05</span><div>
            <h2 class='selected-name'>{projects[0].name}</h2><p class='selected-description'>
              {projects[0].description}
            </p>
          </div>
        </div><div class='project-actions'>
          <a
            class='visit-project'
            href={projects[0].href}
            target='_blank'
            rel='noopener noreferrer'
            data-analytics-event='project_link_click'
            data-analytics-surface='orbit_gallery'>{t('探索项目', 'Explore project')} ↗</a
          ><div class='arrow-controls'>
            <button data-prev aria-label={t('上一个项目', 'Previous project')}>←</button><button
              data-next
              aria-label={t('下一个项目', 'Next project')}>→</button
            ><button data-play aria-label={t('自动旋转', 'Auto rotate')} aria-pressed='false'
              >▷</button
            >
          </div>
        </div>
      </div>
      <script
        is:inline
        type='application/json'
        id='orbit-projects'
        set:html={JSON.stringify(projects).replace(/</g, '\u003c')}
      />
    </section>
    <div class='manifesto-strip'>
      <span>BUILD FAST.</span><span class='strip-star'>✳</span><span>LEARN FASTER.</span><span
        class='strip-star'>✳</span
      ><span>STAY CURIOUS.</span><span class='strip-star'>✳</span>
    </div>
    <section class='writing section-wrap' id='writing'>
      <div class='section-heading'>
        <div>
          <span class='tiny-label'>01 / FIELD NOTES</span><h2>
            {t('边构建，边记录。', 'Learning, out loud.')}
          </h2>
        </div><a href={`${p}/blog`}>{t('全部文章', 'All writing')} ↗</a>
      </div>
      <div class='writing-grid'>
        <div class='articles'>
          {
            posts.map((post, i) => (
              <a class='article-row' href={`${p}/blog/${en ? post.data.translationKey : post.id}`}>
                <>
                  <span class='article-index'>0{i + 1}</span>
                  <div>
                    <>
                      <span class='tiny-label'>
                        {new Intl.DateTimeFormat(en ? 'en-AU' : 'zh-CN', {
                          year: 'numeric',
                          month: 'short',
                          day: 'numeric'
                        }).format(post.data.updatedDate ?? post.data.publishDate)}
                      </span>
                      <h3>{post.data.title}</h3>
                    </>
                  </div>
                  <span class='row-arrow'>↗</span>
                </>
              </a>
            ))
          }{!posts.length && <p>{t('新的记录正在路上。', 'New field notes are on their way.')}</p>}
        </div><aside class='notes-panel'>
          <div class='notes-heading'>
            <span class='tiny-label'>ON MY MIND</span><a href={`${p}/notes`}
              >{t('随手记', 'Notes')} ↗</a
            >
          </div>{
            notes.map((note) => (
              <a class='note-link' href={`${p}/notes/${en ? note.data.translationKey : note.id}`}>
                <>
                  <span>↳</span>
                  <h3>{note.data.title}</h3>
                </>
              </a>
            ))
          }<a
            class='interview-link'
            href='https://joyehuang.dev'
            target='_blank'
            rel='noopener noreferrer'
            ><span class='tiny-label'>SIDE PROJECT / 面试手记</span><strong
              >{t('好的经验，\n不该只留给自己。', 'Lessons worth\npassing on.')}</strong
            ><span
              >{
                t(
                  '158 道真实面试题，连答砸的都有。',
                  '158 real interview questions. Mistakes included.'
                )
              } ↗</span
            ></a
          >
        </aside>
      </div>
    </section>
    <section class='practice section-wrap' id='experience'>
      <div class='section-heading'>
        <div>
          <span class='tiny-label'>02 / IN THE REAL WORLD</span><h2>
            {t('让想法落地的地方。', 'Built with good people.')}
          </h2>
        </div><span class='muted'
          >{
            t('从模型到产品，从研究到实践', 'From models to products. From research to practice.')
          }</span
        >
      </div><div class='experience-list'>
        {
          [
            [
              'Adastra Labs',
              'Playyy.ai',
              t('AI 图像生成与品牌设计', 'AI image generation & brand design'),
              'https://playyy.ai/'
            ],
            [
              'Tezign 特赞',
              'atypica.ai',
              t('商业研究 Multi-Agent 系统', 'Multi-agent commercial research'),
              'https://atypica.ai/'
            ],
            [
              'AIXCut',
              'Video Agent',
              t('AI 视频剪辑 Agent', 'AI-powered video editing'),
              'https://aixcut.cn/'
            ],
            [
              'fAIshion.ai',
              'Virtual Try-on',
              t('AI 虚拟试衣与模型集成', 'AI virtual try-on & model integration'),
              'https://www.faishion.ai/'
            ]
          ].map((item, i) => (
            <a href={item[3]} target='_blank' rel='noopener noreferrer' class='experience-row'>
              <>
                <span class='tiny-label'>0{i + 1}</span>
                <h3>{item[0]}</h3>
                <span>{item[1]}</span>
                <p>{item[2]}</p>
                <span>↗</span>
              </>
            </a>
          ))
        }
      </div>
    </section>
    <section class='about section-wrap' id='about'>
      <div class='portrait-block'>
        <Image src={avatar} alt='Joye Huang' width={400} height={400} loading='lazy' /><div
          class='portrait-caption'
        >
          <span>JOYE HUANG</span><span>37.81° S / 144.96° E</span>
        </div>
      </div><div class='about-copy'>
        <span class='tiny-label'>03 / THE PERSON BEHIND THE PIXELS</span><h2>
          {t('保持好奇，\n然后动手。', 'Stay curious.\nMake things.')}
        </h2><p>
          {
            t(
              '你好，我是 Joye。墨尔本大学计算与软件工程在读，专注 AI Agent 与全栈产品开发。在意 LLM 为什么有效，也在意产品能不能真正跑起来。',
              'Hi, I’m Joye. I study Computing & Software Systems at the University of Melbourne, and build AI agents and full-stack products. I care about why LLMs work — and whether a product actually ships.'
            )
          }
        </p><p class='muted'>
          {
            t(
              '屏幕之外，弹琴、拉大提琴、玩摄影。',
              'Away from the screen: piano, cello, and photography.'
            )
          }
        </p><div class='skill-tags'>
          {
            ['TypeScript', 'React', 'Python', 'LLM', 'Multi-Agent', 'RAG', 'Node.js', 'Bun'].map(
              (x) => <span>{x}</span>
            )
          }
        </div><a class='text-link' href={`${p}/about`}
          >{t('更多关于我', 'A little more about me')} ↗</a
        >
      </div>
    </section>
    {
      talks.length > 0 && (
        <a class='talk-banner section-wrap' href='/talks'>
          <>
            <span class='tiny-label'>COMMUNITY / TALKS</span>
            <div>
              <>
                <span>{t('把交流留在这里', 'Conversations worth keeping')}</span>
                <h3>{talks[0].data.title}</h3>
              </>
            </div>
            <span class='talk-arrow'>↗</span>
          </>
        </a>
      )
    }
    <footer class='site-footer section-wrap'>
      <div class='footer-intro'>
        <span class='tiny-label'
          >{t('下一个想法，从一句你好开始。', 'THE NEXT IDEA STARTS WITH A HELLO.')}</span
        ><a href={`${p}/contact`}>Let’s make<br /><span>something click.</span> ↗</a>
      </div><div class='footer-bottom'>
        <span>© {new Date().getFullYear()} Joye Huang</span><div>
          <a href='https://github.com/joyehuang' target='_blank' rel='noopener noreferrer'
            >GitHub ↗</a
          ><a href={`${p}/projects`}>{t('全部项目', 'All projects')} ↗</a><a href={`${p}/links`}
            >{t('朋友们', 'Friends')} ↗</a
          ><a href='#work'>{t('回到顶部', 'Back to top')} ↑</a>
        </div><span>BUILT WITH CURIOSITY.</span>
      </div>
    </footer>
  </main>
</div>
<script>
  import './orbit'
</script>
<style>
  .orbit-home {
    --accent: #c5ff61;
    --ink: #101210;
    --surface: #191c18;
    --line: #353a32;
    --text: #edf1e7;
    --muted: #a1a89b;
    background: var(--ink);
    color: var(--text);
    font-family: 'Geist Variable', 'Satoshi', sans-serif;
    overflow: clip;
    transition:
      background 0.4s,
      color 0.4s;
    line-height: 1.5;
  }
  .orbit-home[data-palette='ice'] {
    --accent: #91caff;
    --ink: #0e141c;
    --surface: #18222e;
    --line: #34404f;
    --text: #edf4fc;
    --muted: #a4b1c2;
  }
  .orbit-home[data-palette='rose'] {
    --accent: #ffa6ce;
    --ink: #1c111a;
    --surface: #2b1d27;
    --line: #4b3445;
    --text: #fff0f8;
    --muted: #c2a5b7;
  }
  .orbit-home :is(h1, h2, h3, p) {
    margin: 0;
  }
  .orbit-home a {
    text-decoration: none;
    color: inherit;
  }
  .orbit-home button {
    font: inherit;
    color: inherit;
    cursor: pointer;
  }
  .orbit-home a:focus-visible,
  .orbit-home button:focus-visible,
  .orbit-stage:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
  }
  .orbit-home .skip {
    position: absolute;
    left: 24px;
    top: -100px;
    background: var(--accent);
    color: var(--ink);
    padding: 14px;
    z-index: 100;
  }
  .orbit-home .skip:focus {
    top: 14px;
  }
  .muted {
    color: var(--muted);
  }
  .tiny-label {
    font-family: monospace;
    font-size: 12px;
    letter-spacing: 0.07em;
  }
  .orbit-nav {
    height: 100px;
    margin: 0 4.5%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--line);
  }
  .wordmark {
    font-weight: 850;
    font-size: 38px;
    letter-spacing: -3px;
  }
  .wordmark span {
    font-size: 15px;
    vertical-align: super;
    margin-left: 4px;
    letter-spacing: 0;
  }
  .orbit-nav nav {
    display: flex;
    gap: 38px;
    font-size: 14px;
  }
  .orbit-nav nav a:hover,
  .footer-bottom a:hover {
    color: var(--accent);
  }
  .nav-end {
    display: flex;
    gap: 25px;
    align-items: center;
    font-size: 14px;
  }
  .contact-link {
    border: 1px solid var(--line);
    border-radius: 30px;
    padding: 11px 20px;
  }
  .contact-link span {
    margin-left: 18px;
    color: var(--accent);
  }
  .hero {
    padding: 0 4.5%;
    max-width: 1800px;
    margin: auto;
  }
  .hero-topline {
    display: flex;
    justify-content: space-between;
    margin-top: 28px;
    font-family: monospace;
    font-size: 12px;
    letter-spacing: 0.07em;
    color: var(--muted);
  }
  .hero-topline > span:first-child {
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .hero i,
  .terminal-status i {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 15px color-mix(in srgb, var(--accent), transparent 50%);
  }
  .local-time {
    margin-left: 8px;
    color: var(--text);
  }
  .hero-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding: 44px 0 38px;
    gap: 35px;
  }
  .hero-heading h1 {
    font-size: clamp(60px, 7.9vw, 132px);
    font-weight: 530;
    letter-spacing: -0.075em;
    line-height: 0.99;
    position: relative;
    white-space: nowrap;
  }
  .hero-heading h1 > span {
    color: var(--accent);
  }
  .hero-heading sup {
    font-size: 45px;
    position: absolute;
    top: 4px;
    right: -55px;
    color: var(--accent);
  }
  .hero-intro {
    max-width: 275px;
    padding-bottom: 4px;
  }
  .hero-intro .tiny-label {
    color: var(--accent);
    font-size: 11px;
  }
  .hero-intro p {
    font-size: 16px;
    line-height: 1.8;
    white-space: pre-line;
    margin: 16px 0 24px;
  }
  .hero-intro a {
    font-size: 14px;
  }
  .hero-intro a span {
    margin-left: 20px;
    color: var(--accent);
  }
  .exhibit-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }
  .exhibit-header .muted {
    margin-left: 16px;
  }
  .palette-controls {
    display: flex;
