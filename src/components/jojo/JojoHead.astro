---
// <head> part of the Jojo layer: the gate that decides (before first paint)
// whether the build-the-site intro may run on this visit, plus the one CSS rule
// that must exist before any script: the failsafe that un-hides stand-ins.
import gateSource from '@/lib/jojo/head-gate.js?raw'
import { JOJO_KEYS } from '@/lib/jojo/keys'
import { transformSync } from 'esbuild'

const cfg = {
  review: __JOJO_REVIEW__,
  homePaths: ['/', '/en'],
  keys: { intro: JOJO_KEYS.intro, reviewMode: JOJO_KEYS.reviewMode }
}
// the tested source, minified at build time (it ships inline on every page)
const inline = transformSync(
  `${gateSource.replace(/^export .*$/m, '')};jojoHeadGate(window,${JSON.stringify(cfg)});`,
  { minify: true, target: 'es2019', legalComments: 'none' }
).code.trim()
// A piece played by its stand-in is hidden without changing layout. Not
// !important: the failsafe animation must be able to override it, so that if
// cleanup never runs (script error, blocked chunk) the piece reappears after 6 s.
// No transitions while hidden: `visibility` transitions discretely, so a piece
// with `transition-all` (e.g. the GitHub chip) would stay visible next to its
// stand-in for the whole transition.
const failsafeCss =
  'html .jojo-intro-stand-in{visibility:hidden;animation:jojo-intro-failsafe 1ms linear 6s forwards}' +
  'html .jojo-intro-stand-in,html .jojo-intro-stand-in *{transition:none}' +
  '@keyframes jojo-intro-failsafe{to{visibility:visible}}' +
  // review builds: hide surfaces the chosen scheme does not include
  (__JOJO_REVIEW__
    ? "html[data-jojo-mode='b'] [data-jojo-a],html[data-jojo-mode='off'] [data-jojo-a],html[data-jojo-mode='c'] [data-jojo-a]:not([data-jojo-a='seat']){display:none!important}"
    : '')
---

{
  __JOJO__ && (
    <>
      <script is:inline set:html={inline} />
      <style is:inline set:html={failsafeCss} />
    </>
  )
}
