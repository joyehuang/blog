---
// Host for Jojo's night tour on / and /en. Nothing here renders until the
// head gate armed the intro (first visit) or someone asks for a replay; the
// heavy part (React actor + tour) is a separate chunk loaded only then.
---

<script>
  import { createIntroEntry } from '@/lib/jojo/intro/entry'
  import { currentMode, JOJO_EVENTS, modeHas, stillReason } from '@/lib/jojo/keys'

  // Jojo off (no package / PUBLIC_JOJO=0): nothing here runs
  if (__JOJO__) {
    const html = document.documentElement

    /** wait for fonts and the avatar so the stand-ins match the page, but not forever */
    async function ready() {
      const avatar = document.querySelector<HTMLImageElement>('[data-jojo-piece="avatar"]')
      const waits: Promise<unknown>[] = []
      if (document.fonts?.ready) waits.push(document.fonts.ready)
      if (avatar && !avatar.complete) waits.push(avatar.decode().catch(() => {}))
      // the page's own entrance (`.animate` fade-in-up) must be done, or the
      // stand-ins would be measured mid-slide and land off their originals
      for (const el of document.querySelectorAll('main .animate'))
        for (const a of el.getAnimations()) waits.push(a.finished.catch(() => {}))
      await Promise.race([Promise.all(waits), new Promise((r) => setTimeout(r, 1200))])
    }

    const entry = createIntroEntry({
      root: html,
      still: () => stillReason(),
      hasIntro: () => modeHas(currentMode(), 'c'),
      // the heavy chunk: fetched only after the still check passed
      load: () => import('@/lib/jojo/intro/run'),
      emit: (detail) => document.dispatchEvent(new CustomEvent(JOJO_EVENTS.intro, { detail })),
      ready,
      now: () => performance.now(),
      scrollY: () => window.scrollY,
      scrollToTop: () => window.scrollTo({ top: 0, behavior: 'instant' as ScrollBehavior }),
      raf: (cb) => void requestAnimationFrame(cb)
    })

    void entry.boot()
    document.addEventListener(JOJO_EVENTS.introReplay, () => entry.replay())
  }
</script>

<style is:global>
  .jojo-intro-stage {
    position: fixed;
    inset: 0;
    z-index: 75;
    pointer-events: none;
    overflow: hidden;
    contain: layout paint;
  }
  .jojo-intro-piece {
    position: absolute;
    transform-origin: 50% 50%;
    will-change: transform, opacity;
  }
  .jojo-intro-actor {
    position: absolute;
    will-change: transform, left, top;
  }
  .jojo-intro-actor > svg {
    width: 100% !important;
    height: 100% !important;
  }
  /* while the spawn dot pops, the body has none */
  .jojo-intro-actor.is-dot-out [data-layer='signal-dot'] {
    opacity: 0;
  }
  .jojo-intro-spawn {
    position: absolute;
    border-radius: 9999px;
    background: #fe6a4a;
  }
  /* ---- story intros (lib/jojo/intro/story): Jojo's own palette, like the
     character itself; the veil is the page's background, the night is the
     same colour the head gate paints before first paint ---- */
  .jojo-story-veil,
  .jojo-story-night,
  .jojo-story-layer {
    position: absolute;
    inset: 0;
  }
  .jojo-story-veil {
    opacity: 0;
    background: hsl(var(--background));
  }
  .jojo-story-night {
    background: #070914;
  }
  .jojo-story-flash {
    position: absolute;
    border-radius: 9999px;
    background: radial-gradient(
      circle,
      rgb(255 236 200 / 0.55) 0%,
      rgb(255 236 200 / 0.18) 40%,
      transparent 70%
    );
    opacity: 0;
  }
  .jojo-story-tag {
    position: absolute;
    left: 0;
    top: 0;
    padding: 0.2rem 0.65rem;
    border: 2px solid #2d3272;
    border-radius: 9999px;
    background: #fff;
    color: #2d3272;
    font-family: 'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 12px;
    font-weight: 600;
    line-height: 18px;
    white-space: nowrap;
    box-shadow: 0 6px 16px rgb(20 24 60 / 0.16);
    opacity: 0;
  }
  .jojo-story-bubble {
    position: absolute;
    left: 0;
    top: 0;
    max-width: min(300px, calc(100vw - 24px));
    padding: 0.5rem 0.8rem;
    border: 2px solid #2d3272;
    border-radius: 14px;
    background: #fff;
    color: #2d3272;
    font-size: 15px;
    font-weight: 500;
    line-height: 22px;
    box-shadow: 0 10px 28px rgb(20 24 60 / 0.18);
    opacity: 0;
  }
  .jojo-story-bubble::after {
    content: '';
    position: absolute;
    left: var(--tail, 50%);
    bottom: -7px;
    width: 12px;
    height: 12px;
    border-right: 2px solid #2d3272;
    border-bottom: 2px solid #2d3272;
    background: #fff;
    transform: translateX(-50%) rotate(45deg);
  }
  .jojo-story-bubble[data-side='below']::after {
    top: -7px;
    bottom: auto;
    transform: translateX(-50%) rotate(225deg);
  }
  .jojo-story-bubble[data-side='right']::after,
  .jojo-story-bubble[data-side='left']::after {
    top: var(--tail, 50%);
    bottom: auto;
  }
  .jojo-story-bubble[data-side='right']::after {
    left: -7px;
    transform: translateY(-50%) rotate(135deg);
  }
  .jojo-story-bubble[data-side='left']::after {
    left: auto;
    right: -7px;
    transform: translateY(-50%) rotate(-45deg);
  }
  .jojo-story-char {
    opacity: 0;
    transition: opacity 0.16s ease-out;
  }
  .jojo-story-char.is-on {
    opacity: 1;
  }
  .jojo-story-badge {
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 2px solid #2d3272;
    border-radius: 9999px;
    background: #fff;
    box-shadow: 0 6px 16px rgb(20 24 60 / 0.16);
    opacity: 0;
  }
  .jojo-story-badge svg {
    width: 21px;
    height: 21px;
    fill: none;
    stroke: #2d3272;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .jojo-story-glow {
    position: absolute;
    border-radius: 9999px;
    background: radial-gradient(
      circle,
      rgb(255 226 170 / 0.3) 0%,
      rgb(255 226 170 / 0.1) 45%,
      transparent 70%
    );
    opacity: 0;
  }
  .jojo-story-ping {
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 9999px;
    background: #fe6a4a;
    color: #fff;
    font-size: 16px;
    font-weight: 800;
    opacity: 0;
  }
  .jojo-story-z {
    position: absolute;
    left: 0;
    top: 0;
    color: #cfd6ff;
    font-weight: 700;
    opacity: 0;
  }
  /* the indigo shell would sink into the night: a hairline halo */
  .jojo-story--tour .jojo-intro-actor > svg {
    filter: drop-shadow(0 0 0.8px rgb(255 255 255 / 0.8))
      drop-shadow(0 0 10px rgb(180 200 255 / 0.25));
  }
  @media (max-width: 640px) {
    .jojo-story-bubble {
      max-width: min(240px, calc(100vw - 24px));
      font-size: 14px;
      line-height: 20px;
    }
  }
  .jojo-intro-skip {
    position: fixed;
    z-index: 76;
    left: 50%;
    bottom: calc(1.25rem + env(safe-area-inset-bottom, 0px));
    transform: translateX(-50%);
    border-radius: 9999px;
    border: 1px solid hsl(var(--border));
    background: hsl(var(--background) / 0.86);
    backdrop-filter: blur(8px);
    padding: 0.4rem 1rem;
    font-size: 0.8125rem;
    line-height: 1.25rem;
    color: hsl(var(--muted-foreground));
    box-shadow: 0 8px 24px hsl(var(--foreground) / 0.08);
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }
  .jojo-intro-skip:hover {
    color: hsl(var(--foreground));
    border-color: hsl(var(--foreground) / 0.25);
  }
  .jojo-intro-skip:focus-visible {
    outline: 2px solid hsl(var(--ring));
    outline-offset: 2px;
  }
  .jojo-intro-skip::after {
    content: ' ›';
  }
  /* phones: bottom centre is where Jojo works (About, the last labels), so
     Skip gets the bottom-right corner (the dock is hidden while the intro
     runs) with a full-size touch target; the route planner keeps Jojo out of
     whatever rect this ends up at */
  @media (max-width: 640px) {
    .jojo-intro-skip {
      left: auto;
      right: calc(1rem + env(safe-area-inset-right, 0px));
      bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
      transform: none;
      min-height: 2.75rem;
      padding: 0.625rem 1.125rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    /* every entry refuses under reduced motion and a run ends if it turns on;
       this only covers the frame before that script runs */
    .jojo-intro-stage,
    .jojo-intro-skip {
      display: none;
    }
    html .jojo-intro-stand-in {
      visibility: visible;
    }
  }
</style>
