---
// Scheme A — 404: a puzzled static Jojo and one line. Zero JavaScript.
import JojoMark from './JojoMark.astro'

interface Props {
  lang: 'zh' | 'en'
}
const zh = Astro.props.lang === 'zh'
---

{
  __JOJO__ && (
    <div class='jojo-404' data-jojo-anchor data-jojo-a='404'>
      <JojoMark id='nf' emotion='puzzled' size={88} />
      <p class='jojo-404-line'>
        {zh
          ? '这页走丢了，Jojo 也没找到。'
          : 'This page wandered off. Jojo looked everywhere, too.'}
      </p>
    </div>
  )
}

<style>
  .jojo-404 {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .jojo-404-line {
    color: hsl(var(--muted-foreground));
  }
</style>
