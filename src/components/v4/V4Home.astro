---
import { Image } from 'astro:assets'
import avatar from 'src/assets/avatar.png'

import { buildSpiral } from './spiral'
import type { V4Counts, V4Item, V4Locale, V4Milestone, V4Repo } from './types'

interface Props {
  locale?: V4Locale
  posts: V4Item[]
  notes: V4Item[]
  repos: V4Repo[]
  milestones: V4Milestone[]
  counts: V4Counts
}

const { locale = 'zh', posts, notes, repos, milestones, counts } = Astro.props
const isEn = locale === 'en'

/* ------------------------------------------------------------------ */
/* copy — every claim below is lifted from the blog                     */
/* ------------------------------------------------------------------ */

const copy = isEn
  ? {
      running: 'still running',
      eyebrow: ['Joye', 'University of Melbourne', 'Agent Engineering'],
      thesisA: 'The buzzwords are noise.',
      thesisB: 'The system is signal.',
      lede: 'On 27 June 2025 I opened my first pull request. Everything after it — the interviews, the dead ends, the source I read, the rejections — I wrote down. This line is the twelve months since.',
      spiralCaption: 'one line, twelve months, still drawing',
      ctaRead: 'Read what I write',
      ctaAbout: 'Get to know me',
      motto: 'Build fast, learn faster.',
      scroll: 'scroll',

      ledgerTitle: 'the ledger',
      ledgerNote:
        'From a first PR to sitting on the interviewer’s side of the table — twelve months.',

      arcKicker: '01 / the year',
      arcTitle: 'What actually happened',
      arcNote: 'Every entry links to the post it came from. Nothing here is a summary of nothing.',

      loopKicker: '02 / the engine',
      loopTitle: 'A system that keeps running',
      loopQuote:
        '“Build a small thing, run into a real problem, distil it into a post, a skill or a note, publish it — and you have a growth loop.”',
      loopNote:
        'Two systems, one shape: a resident agent on the technical side, this loop on the growth side. Pick a station.',
      loopHint: 'hover or tap a station',

      ringsKicker: '03 / the field',
      ringsTitle: 'The nouns change faster than the models',
      ringsLede:
        'Prompt → Context → Harness → Loop. Four relays in one year. The model barely moved; what changed is the ring you work on.',
      ringsCenter: 'model',
      ringsClosing:
        'Word → context → environment → mechanism. Same job every time: build a system outward, ring by ring, around a core that never changed.',
      proofLabel: 'the receipt',
      proofBody:
        'LangChain left the model untouched and rebuilt only the harness — Terminal-Bench 2.0 went from 52.8% to 66.5%. Roughly a free model generation.',
      proofQuote:
        '“Agent = model + harness. You are either the model or the harness — everything outside the model is harness.”',
      proofSource: 'Vivek Trivedy, LangChain',

      writingKicker: '04 / the evidence',
      writingTitle: 'What I write',
      essays: 'long-form',
      research: 'research notes',
      writingMore: 'All posts',
      notesMore: 'All notes',

      offKicker: '05 / off the clock',
      offTitle: 'Not only engineering',
      offBody:
        'Piano and cello since primary school — both because my parents made me. Now, when debugging wears me out, I play for a while; it works better than coffee. I also build scale models, and photography is the new one. I live in Melbourne: weekends are St Kilda beach, or a whole day inside the State Library.',
      offTags: ['piano', 'cello', 'scale models', 'photography', 'Melbourne'],

      endTitle: 'Rather than chase every noun,\nbuild a system that keeps running.',
      endNote: 'Open to internship and graduate roles in agent engineering.',
      endLinks: [
        { label: 'Blog', href: '/en/blog' },
        { label: 'About', href: '/en/about' },
        { label: 'Notes', href: '/en/notes' },
        { label: 'GitHub', href: 'https://github.com/joyehuang' },
        { label: 'Contact', href: '/en/contact' }
      ],
      langHref: '/v4',
      langLabel: '中文',
      navItems: [
        { label: 'Blog', href: '/en/blog' },
        { label: 'About', href: '/en/about' }
      ]
    }
  : {
      running: '系统仍在运行',
      eyebrow: ['Joye', '墨尔本大学在读', 'Agent Engineering'],
      thesisA: '名词只是噪音，',
      thesisB: '系统才是信号。',
      lede: '2025 年 6 月 27 日，我提了人生中第一个 PR。之后的每一步——面试、踩的坑、读过的源码、被拒绝的时刻——我都写了下来。这条线，就是那之后的 12 个月。',
      spiralCaption: '一条线，十二个月，还在画',
      ctaRead: '读我写的',
      ctaAbout: '认识我',
      motto: 'Build fast, learn faster.',
      scroll: '往下',

      ledgerTitle: '账本',
      ledgerNote: '从第一个 PR，到坐在面试官那一侧——12 个月。',

      arcKicker: '01 / 这一年',
      arcTitle: '具体发生了什么',
      arcNote: '每一条都链回它出处的那篇文章。没有一句是凭空总结的。',

      loopKicker: '02 / 引擎',
      loopTitle: '一个能自己跑下去的系统',
      loopQuote:
        '「先做个小东西，遇到真实的问题，沉淀成文章、Skills 或笔记，公开出来，形成成长闭环。」',
      loopNote: '两个系统，同一个形状：技术上是一个常驻 agent，成长上就是这个环。点一个节点看看。',
      loopHint: '悬停或点击任一节点',

      ringsKicker: '03 / 这个行业',
      ringsTitle: '名词换得比模型还快',
      ringsLede:
        'Prompt → Context → Harness → Loop，一年之内四拨接力。模型基本没变，变的是你下手的那一圈。',
      ringsCenter: '模型',
      ringsClosing:
        '词 → 上下文 → 环境 → 机制。做的始终是同一件事：围着那个不变的模型核心，一层层向外搭一个系统。',
      proofLabel: '硬证据',
      proofBody:
        'LangChain 模型一行没动，只重做了 harness，Terminal-Bench 2.0 就从 52.8% 冲到 66.5%，整整 +13.7 分——约等于白嫖了一整代模型的进步。',
      proofQuote:
        '「Agent = 模型 + Harness。你要么是模型，要么就是 harness——模型之外的一切，都是 harness。」',
      proofSource: 'Vivek Trivedy · LangChain',

      writingKicker: '04 / 证据',
      writingTitle: '写的东西',
      essays: '长文',
      research: '研究笔记',
      writingMore: '全部文章',
      notesMore: '全部笔记',

      offKicker: '05 / 下班以后',
      offTitle: '不只是工程',
      offBody:
        '从小学钢琴和大提琴，都是被父母「逼」着学的。现在 debug 累了会去弹一会，效果比咖啡还好。还喜欢组模型，摄影是新爱好。人在墨尔本，周末去 St Kilda 海滩散步，或者在 State Library 泡一整天。',
      offTags: ['钢琴', '大提琴', '模型制作', '摄影', '墨尔本'],

      endTitle: '与其追每个名词，\n不如建一个能自己跑下去的系统。',
      endNote: '开放实习 / 全职机会 · Agent 方向。',
      endLinks: [
        { label: '博客', href: '/blog' },
        { label: '关于', href: '/about' },
        { label: '笔记', href: '/notes' },
        { label: 'GitHub', href: 'https://github.com/joyehuang' },
        { label: '联系', href: '/contact' }
      ],
      langHref: '/en/v4',
      langLabel: 'EN',
      navItems: [
        { label: 'Blog', href: '/blog' },
        { label: 'About', href: '/about' }
      ]
    }

/* ------------------------------------------------------------------ */
/* the ledger — live counts, plus two figures stated in the posts       */
/* ------------------------------------------------------------------ */

const ledger = isEn
  ? [
      { value: String(counts.posts), unit: 'posts', label: 'long-form' },
      { value: String(counts.notes), unit: 'notes', label: 'research' },
      { value: '100+', unit: 'rounds', label: 'agent interviews' },
      { value: String(counts.stars), unit: '★', label: 'GitHub stars' },
      { value: String(counts.talks), unit: 'sessions', label: 'talks given' },
      { value: String(counts.teams), unit: 'teams', label: 'Summer of Agents' }
    ]
  : [
      { value: String(counts.posts), unit: '篇', label: '长文' },
      { value: String(counts.notes), unit: '篇', label: '研究笔记' },
      { value: '100+', unit: '场', label: 'Agent 岗面试' },
      { value: String(counts.stars), unit: '★', label: 'GitHub stars' },
      { value: String(counts.talks), unit: '期', label: '分享会' },
      { value: String(counts.teams), unit: '支', label: 'Summer of Agents 参赛队' }
    ]

/* ------------------------------------------------------------------ */
/* the loop — four stations, each backed by real artefacts              */
/* ------------------------------------------------------------------ */

type Station = {
  key: string
  index: string
  name: string
  verb: string
  line: string
  /** `repo` marks an outbound GitHub link, which is the one click worth tracking. */
  items: { title: string; note: string; href?: string; repo?: string }[]
}

const stations: Station[] = isEn
  ? [
      {
        key: 'build',
        index: '01',
        name: 'Build',
        verb: 'make a small thing',
        line: 'Start with something small enough to actually finish.',
        items: repos.map((repo) => ({
          title: repo.name,
          note: `${repo.eyebrow} · ★ ${repo.stars}`,
          href: repo.href,
          repo: repo.name
        }))
      },
      {
        key: 'break',
        index: '02',
        name: 'Break',
        verb: 'hit a real problem',
        line: 'Ship it and you will run into problems no tutorial has.',
        items: [
          {
            title: '100+ agent interviews',
            note: 'Interviewing as a way to keep calibrating',
            href: '/en/blog'
          },
          {
            title: 'Internship at Tezign, AIGC team',
            note: 'AI in an actual product',
            href: '/en/about'
          },
          {
            title: 'Read 11,733 lines of OpenHarness',
            note: 'CLI boot to agent loop, in one day',
            href: '/en/blog'
          }
        ]
      },
      {
        key: 'distil',
        index: '03',
        name: 'Distil',
        verb: 'write it down',
        line: 'A post, a skill, a note — anything that outlives the session.',
        items: [
          {
            title: `${counts.posts} long-form posts`,
            note: 'From first PR to agent engineering',
            href: '/en/blog'
          },
          {
            title: `${counts.notes} research notes`,
            note: 'RAG, memory, caching, harness',
            href: '/en/notes'
          },
          { title: 'Curated reading', note: 'Outside work, digested', href: '/en/curated' }
        ]
      },
      {
        key: 'publish',
        index: '04',
        name: 'Publish',
        verb: 'put it in public',
        line: 'Publishing forces the output — then it loops back to build.',
        items: [
          {
            title: `${counts.talks} community talks`,
            note: `${counts.attendees} people across the sessions`,
            href: '/en/blog'
          },
          {
            title: 'Blog · Bilibili · Xiaohongshu',
            note: 'Decks and recordings, all public',
            href: '/en/about'
          },
          {
            title: 'Summer of Agents',
            note: `${counts.teams} teams building right now`,
            href: '/agent-teams'
          }
        ]
      }
    ]
  : [
      {
        key: 'build',
        index: '01',
        name: '做',
        verb: '先做个小东西',
        line: '从一个小到真能做完的东西开始。',
        items: repos.map((repo) => ({
          title: repo.name,
          note: `${repo.eyebrow} · ★ ${repo.stars}`,
          href: repo.href,
          repo: repo.name
        }))
      },
      {
        key: 'break',
        index: '02',
        name: '碰',
        verb: '碰到真实问题',
        line: '只要真做出来，就一定会撞上教程里没有的问题。',
        items: [
          { title: '100+ 场 Agent 岗面试', note: '把面试当成持续校准的方式', href: '/blog' },
          { title: '特赞 AIGC 研发部实习', note: '看 AI 怎么落到真实产品里', href: '/about' },
          {
            title: '读完 11,733 行 OpenHarness',
            note: '一天走读完 CLI 启动到 Agent Loop',
            href: '/blog'
          }
        ]
      },
      {
        key: 'distil',
        index: '03',
        name: '沉淀',
        verb: '沉淀成文字',
        line: '文章、Skills 或笔记——任何比这次会话活得更久的东西。',
        items: [
          {
            title: `${counts.posts} 篇长文`,
            note: '从第一个 PR 一路写到 Agent 开发',
            href: '/blog'
          },
          { title: `${counts.notes} 篇研究笔记`, note: 'RAG、记忆、缓存、harness', href: '/notes' },
          { title: '精读栏目', note: '外面的好东西，消化过再放出来', href: '/curated' }
        ]
      },
      {
        key: 'publish',
        index: '04',
        name: '公开',
        verb: '公开出来',
        line: '公开这件事本身会倒逼你输出——然后回到起点。',
        items: [
          {
            title: `${counts.talks} 期粉丝群分享会`,
            note: `累计 ${counts.attendees} 位群友`,
            href: '/blog'
          },
          { title: '博客 · B 站 · 小红书', note: 'PPT 和回放全部公开', href: '/about' },
          {
            title: 'Summer of Agents',
            note: `${counts.teams} 支队伍正在开发中`,
            href: '/agent-teams'
          }
        ]
      }
    ]

/* Four stations on a circle, wired clockwise. */
const LOOP_SIZE = 300
const LOOP_C = LOOP_SIZE / 2
const LOOP_R = 108
const polar = (deg: number, r: number) => ({
  x: LOOP_C + Math.cos((deg * Math.PI) / 180) * r,
  y: LOOP_C + Math.sin((deg * Math.PI) / 180) * r
})
const loopNodes = stations.map((station, i) => ({
  station,
  deg: -90 + i * 90,
  ...polar(-90 + i * 90, LOOP_R)
}))
const loopArrows = [0, 1, 2, 3].map((i) => {
  const deg = -45 + i * 90
  return { ...polar(deg, LOOP_R), rotate: deg + 90 }
})

/* ------------------------------------------------------------------ */
/* the rings — the noun relay, expanding outward around the model       */
/* ------------------------------------------------------------------ */

type Ring = { era: string; name: string; gloss: string; radius: number }

const rings: Ring[] = isEn
  ? [
      { era: "'22–'23", name: 'Prompt Engineering', gloss: 'Write the sentence well.', radius: 52 },
      {
        era: "'25.6",
        name: 'Context Engineering',
        gloss: 'Manage everything the model sees.',
        radius: 86
      },
      {
        era: "'26",
        name: 'Harness Engineering',
        gloss: 'Put scaffolding around the model.',
        radius: 120
      },
      {
        era: "'26.6",
        name: 'Loop Engineering',
        gloss: 'Stop prompting by hand — design the loop.',
        radius: 154
      }
    ]
  : [
      { era: "'22–'23", name: 'Prompt Engineering', gloss: '把一句话写好。', radius: 52 },
      { era: "'25.6", name: 'Context Engineering', gloss: '管好模型看到的一切。', radius: 86 },
      { era: "'26 初", name: 'Harness Engineering', gloss: '给模型套上脚手架。', radius: 120 },
      {
        era: "'26.6",
        name: 'Loop Engineering',
        gloss: '别再手动 prompt，去设计循环。',
        radius: 154
      }
    ]

const RING_SIZE = 360
const RING_C = RING_SIZE / 2
const ringTicks = rings.map((ring, i) => {
  const deg = -128 + i * 26
  const rad = (deg * Math.PI) / 180
  return {
    ...ring,
    i,
    x: RING_C + Math.cos(rad) * ring.radius,
    y: RING_C + Math.sin(rad) * ring.radius
  }
})

/* ------------------------------------------------------------------ */
/* the hero spiral — generated at build time, animated in pure CSS      */
/* ------------------------------------------------------------------ */

const nodeAt = milestones.map((_, i) => 0.14 + (i * 0.86) / Math.max(1, milestones.length - 1))
const spiral = buildSpiral({ nodeAt })
---

<v4-home class='paper' data-locale={locale}>
  <div class='grain' aria-hidden='true'></div>

  <header class='rail'>
    <a class='rail__mark' href={isEn ? '/en/v4' : '/v4'}>
      <span class='rail__pip' aria-hidden='true'></span>
      Joye <span class='rail__ver'>v4</span>
    </a>
    <nav class='rail__nav' aria-label={isEn ? 'Quick links' : '快捷链接'}>
      {copy.navItems.map((item) => <a href={item.href}>{item.label}</a>)}
      <a class='rail__lang' href={copy.langHref}>{copy.langLabel}</a>
    </nav>
  </header>

  <main>
    {/* ------------------------------- hero ------------------------------- */}
    <section class='hero' id='top'>
      <div class='hero__copy'>
        <p class='badge'>
          <span class='badge__pip' aria-hidden='true'></span>
          {copy.running}
        </p>
        <p class='hero__eyebrow'>
          {
            copy.eyebrow.map((part, i) => (
              <>
                {i > 0 && (
                  <span class='sep' aria-hidden='true'>
                    /
                  </span>
                )}
                <span>{part}</span>
              </>
            ))
          }
        </p>
        <h1 class='hero__name'>Joye</h1>
        <p class='hero__thesis'>
          <span class='thesis__noise'>{copy.thesisA}</span>
          <span class='thesis__signal'>{copy.thesisB}</span>
        </p>
        <p class='hero__lede'>{copy.lede}</p>
        <div class='hero__actions'>
          <a class='btn btn--solid' href={isEn ? '/en/blog' : '/blog'}>
            {copy.ctaRead}
            <span aria-hidden='true'>→</span>
          </a>
          <a class='btn' href={isEn ? '/en/about' : '/about'}>{copy.ctaAbout}</a>
        </div>
        <p class='hero__motto'>{copy.motto}</p>
      </div>

      <figure class='hero__art' aria-hidden='true'>
        <svg viewBox={`0 0 ${spiral.size} ${spiral.size}`} class='spiral'>
          {/* second plate, deliberately mis-registered — riso print habit */}
          <path class='spiral__ghost' d={spiral.d} transform='translate(4.5 -3)'></path>
          <path
            id='v4-spiral-path'
            class='spiral__line'
            d={spiral.d}
            style={`--len:${spiral.length}`}></path>
          {
            spiral.nodes.map((node, i) => (
              <g class='spiral__node' style={`--delay:${(0.35 + node.t * 2.05).toFixed(2)}s`}>
                <circle cx={node.x} cy={node.y} r='7.5' class='spiral__halo' />
                <circle cx={node.x} cy={node.y} r={i === spiral.nodes.length - 1 ? 4.4 : 3} />
              </g>
            ))
          }
          <circle class='spiral__pulse' r='3.6' data-motion>
            <animateMotion dur='26s' repeatCount='indefinite' begin='2.4s' rotate='auto'>
              <mpath href='#v4-spiral-path'></mpath>
            </animateMotion>
          </circle>
        </svg>
        <figcaption class='hero__caption'>{copy.spiralCaption}</figcaption>
      </figure>

      <p class='hero__scroll' aria-hidden='true'>{copy.scroll} ↓</p>
    </section>

    {/* ------------------------------ ledger ------------------------------ */}
    <section class='ledger' data-reveal>
      <h2 class='sr-only'>{copy.ledgerTitle}</h2>
      <ul class='ledger__grid'>
        {
          ledger.map((row) => (
            <li class='ledger__cell'>
              <span class='ledger__value'>
                {row.value}
                <i>{row.unit}</i>
              </span>
              <span class='ledger__label'>{row.label}</span>
            </li>
          ))
        }
      </ul>
      <p class='ledger__note'>{copy.ledgerNote}</p>
    </section>

    {/* ------------------------------- arc -------------------------------- */}
    <section class='band' id='arc'>
      <div class='band__head' data-reveal>
        <p class='kicker'>{copy.arcKicker}</p>
        <h2 class='band__title'>{copy.arcTitle}</h2>
        <p class='band__note'>{copy.arcNote}</p>
      </div>
      <ol class='arc'>
        {
          milestones.map((milestone, i) => {
            const Tag = milestone.href ? 'a' : 'div'
            return (
              <li class='arc__row' data-reveal style={`--i:${i}`}>
                <Tag class='arc__link' href={milestone.href}>
                  <span class='arc__date'>{milestone.date}</span>
                  <span class='arc__dot' aria-hidden='true' />
                  <span class='arc__body'>
                    <span class='arc__title'>{milestone.title}</span>
                    <span class='arc__note'>{milestone.note}</span>
                  </span>
                  {milestone.href && (
                    <span class='arc__go' aria-hidden='true'>
                      ↗
                    </span>
                  )}
                </Tag>
              </li>
            )
          })
        }
      </ol>
    </section>

    {/* ------------------------------- loop ------------------------------- */}
    <section class='band band--loop' id='loop'>
      <div class='band__head' data-reveal>
        <p class='kicker'>{copy.loopKicker}</p>
        <h2 class='band__title'>{copy.loopTitle}</h2>
        <blockquote class='pull'>{copy.loopQuote}</blockquote>
        <p class='band__note'>{copy.loopNote}</p>
      </div>

      <div class='loop' data-loop>
        <div class='loop__dial'>
          <svg viewBox={`0 0 ${LOOP_SIZE} ${LOOP_SIZE}`} aria-hidden='true'>
            <circle class='loop__track' cx={LOOP_C} cy={LOOP_C} r={LOOP_R}></circle>
            <circle class='loop__sweep' cx={LOOP_C} cy={LOOP_C} r={LOOP_R}></circle>
            {
              loopArrows.map((arrow) => (
                <path
                  class='loop__arrow'
                  d='M -4 -4 L 0 0 L -4 4'
                  transform={`translate(${arrow.x.toFixed(1)} ${arrow.y.toFixed(1)}) rotate(${arrow.rotate})`}
                />
              ))
            }
            {
              loopNodes.map(({ station, x, y }) => (
                <g class='loop__node' data-node={station.key}>
                  <circle cx={x.toFixed(1)} cy={y.toFixed(1)} r='26' class='loop__disc' />
                  <text x={x.toFixed(1)} y={y.toFixed(1)} class='loop__glyph'>
                    {station.name}
                  </text>
                </g>
              ))
            }
            <text x={LOOP_C} y={LOOP_C - 6} class='loop__core'>loop</text>
            <text x={LOOP_C} y={LOOP_C + 12} class='loop__coreSub'>{copy.loopHint}</text>
          </svg>

          <div class='loop__tabs' role='tablist' aria-label={copy.loopTitle}>
            {
              stations.map((station, i) => (
                <button
                  type='button'
                  role='tab'
                  class='loop__tab'
                  data-tab={station.key}
                  id={`v4-tab-${station.key}`}
                  aria-controls={`v4-panel-${station.key}`}
                  aria-selected={i === 0 ? 'true' : 'false'}
                  tabindex={i === 0 ? 0 : -1}
                >
                  <i>{station.index}</i>
                  {station.name}
                </button>
              ))
            }
          </div>
        </div>

        <div class='loop__panels'>
          {
            stations.map((station, i) => (
              <div
                class='loop__panel'
                data-panel={station.key}
                id={`v4-panel-${station.key}`}
                role='tabpanel'
                aria-labelledby={`v4-tab-${station.key}`}
                hidden={i !== 0}
              >
                <p class='loop__verb'>
                  <span class='loop__index'>{station.index}</span>
                  {station.verb}
                </p>
                <p class='loop__line'>{station.line}</p>
                <ul class='loop__items'>
                  {station.items.map((item) => (
                    <li>
                      <a
                        href={item.href}
                        target={item.repo ? '_blank' : undefined}
                        rel={item.repo ? 'noopener noreferrer' : undefined}
                        data-analytics-event={item.repo ? 'github_link_click' : undefined}
                        data-analytics-surface={item.repo ? 'v4_open_source' : undefined}
                        data-analytics-target={item.repo ? 'repo' : undefined}
                        data-analytics-repo={item.repo}
                      >
                        <span class='loop__itemTitle'>{item.title}</span>
                        <span class='loop__itemNote'>{item.note}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* ------------------------------- rings ------------------------------ */}
    <section class='band band--rings' id='rings'>
      <div class='band__head' data-reveal>
        <p class='kicker'>{copy.ringsKicker}</p>
        <h2 class='band__title'>{copy.ringsTitle}</h2>
        <p class='band__note'>{copy.ringsLede}</p>
      </div>

      <div class='rings' data-rings>
        <figure class='rings__dial' aria-hidden='true'>
          <svg viewBox={`0 0 ${RING_SIZE} ${RING_SIZE}`}>
            {
              ringTicks.map((ring) => (
                <circle
                  class='rings__ring'
                  data-ring={ring.i}
                  cx={RING_C}
                  cy={RING_C}
                  r={ring.radius}
                  style={`--delay:${(ring.i * 0.12).toFixed(2)}s`}
                />
              ))
            }
            <circle class='rings__core' cx={RING_C} cy={RING_C} r='30'></circle>
            <text class='rings__coreLabel' x={RING_C} y={RING_C + 4}>{copy.ringsCenter}</text>
            {
              ringTicks.map((ring) => (
                <g class='rings__tick' data-tick={ring.i}>
                  <circle cx={ring.x.toFixed(1)} cy={ring.y.toFixed(1)} r='4.5' />
                  <text x={ring.x.toFixed(1)} y={(ring.y - 12).toFixed(1)}>
                    {ring.i + 1}
                  </text>
                </g>
              ))
            }
          </svg>
        </figure>

        <ol class='rings__list'>
          {
            rings.map((ring, i) => (
              <li class='rings__item' data-ring-item={i} data-reveal style={`--i:${i}`}>
                <span class='rings__n'>{i + 1}</span>
                <span class='rings__era'>{ring.era}</span>
                <span class='rings__name'>{ring.name}</span>
                <span class='rings__gloss'>{ring.gloss}</span>
              </li>
            ))
          }
        </ol>
      </div>

      <div class='proof' data-reveal>
        <p class='proof__label'>{copy.proofLabel}</p>
        <p class='proof__body'>{copy.proofBody}</p>
        <div class='proof__bar' aria-hidden='true'>
          <span class='proof__from'><i style='--w:52.8%'></i>52.8%</span>
          <span class='proof__to'><i style='--w:66.5%'></i>66.5%</span>
        </div>
        <blockquote class='proof__quote'>
          {copy.proofQuote}
          <cite>{copy.proofSource}</cite>
        </blockquote>
      </div>

      <p class='band__closing' data-reveal>{copy.ringsClosing}</p>
    </section>

    {/* ------------------------------ writing ----------------------------- */}
    <section class='band' id='writing'>
      <div class='band__head' data-reveal>
        <p class='kicker'>{copy.writingKicker}</p>
        <h2 class='band__title'>{copy.writingTitle}</h2>
      </div>

      <div class='index'>
        <div class='index__col' data-reveal>
          <p class='index__label'>
            {copy.essays}
            <a href={isEn ? '/en/blog' : '/blog'}>{copy.writingMore} →</a>
          </p>
          <ul>
            {
              posts.map((post) => (
                <li>
                  <a href={post.href}>
                    <span class='index__meta'>{post.meta}</span>
                    <span class='index__title'>{post.title}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class='index__col' data-reveal>
          <p class='index__label'>
            {copy.research}
            <a href={isEn ? '/en/notes' : '/notes'}>{copy.notesMore} →</a>
          </p>
          <ul>
            {
              notes.map((note) => (
                <li>
                  <a href={note.href}>
                    <span class='index__meta'>{note.meta}</span>
                    <span class='index__title'>{note.title}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    {/* ----------------------------- off-clock ---------------------------- */}
    <section class='band band--off' id='off'>
      <div class='off' data-reveal>
        <div class='off__portrait'>
          <Image src={avatar} alt='Joye' width={200} height={200} loading='lazy' />
        </div>
        <div class='off__copy'>
          <p class='kicker'>{copy.offKicker}</p>
          <h2 class='band__title'>{copy.offTitle}</h2>
          <p class='off__body'>{copy.offBody}</p>
          <ul class='off__tags'>
            {copy.offTags.map((tag) => <li>{tag}</li>)}
          </ul>
        </div>
      </div>
    </section>

    {/* ------------------------------- end -------------------------------- */}
    <section class='end' id='end'>
      <p class='end__title' data-reveal>{copy.endTitle}</p>
      <p class='end__note' data-reveal>{copy.endNote}</p>
      <ul class='end__links' data-reveal>
        {
          copy.endLinks.map((link) => {
            const external = link.href.startsWith('http')
            return (
              <li>
                <a
                  href={link.href}
                  target={external ? '_blank' : undefined}
                  rel={external ? 'noopener noreferrer' : undefined}
                  data-analytics-event={external ? 'github_link_click' : undefined}
                  data-analytics-surface={external ? 'v4_footer' : undefined}
                  data-analytics-target={external ? 'profile' : undefined}
                >
                  {link.label}
                </a>
              </li>
            )
          })
        }
      </ul>
      <p class='end__foot'>
        <span>© {new Date().getFullYear()} Joye</span>
        <span class='sep' aria-hidden='true'>/</span>
        <span>{isEn ? 'built with Astro' : '用 Astro 搭的'}</span>
      </p>
    </section>
  </main>
</v4-home>

<script>
  import './v4-engine'
</script>

<style>
  /* ==================================================================== */
  /* v4 — ink on paper. Its own token set; the page owns its whole surface. */
  /* ==================================================================== */

  v4-home {
    --paper: 42 33% 95%;
    --paper-deep: 40 26% 91%;
    --ink: 30 10% 11%;
    --ink-dim: 30 6% 36%;
