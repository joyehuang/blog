      border-color 0.25s ease,
      color 0.25s ease;
  }

  .btn:hover {
    transform: translateY(-2px);
    border-color: hsl(var(--ink));
  }

  .btn--solid {
    background: hsl(var(--ink));
    border-color: hsl(var(--ink));
    color: hsl(var(--paper));
  }

  .btn--solid:hover {
    background: hsl(var(--signal));
    border-color: hsl(var(--signal));
    color: #fff;
  }

  .btn--solid span {
    transition: transform 0.25s ease;
  }

  .btn--solid:hover span {
    transform: translateX(3px);
  }

  .hero__motto {
    margin: 0;
    font-size: 0.85rem;
    font-style: italic;
    color: hsl(var(--ink-faint));
  }

  /* --- the spiral --- */

  .hero__art {
    position: relative;
    width: 100%;
    margin: 0;
  }

  .spiral {
    display: block;
    width: min(34rem, 100%);
    height: auto;
    margin-inline: auto;
    overflow: visible;
  }

  .spiral__line,
  .spiral__ghost {
    fill: none;
    stroke-linecap: round;
    stroke-dasharray: var(--len, 4000);
    stroke-dashoffset: var(--len, 4000);
    animation: v4-draw 2.6s cubic-bezier(0.32, 0.9, 0.35, 1) 0.15s forwards;
  }

  .spiral__line {
    stroke: hsl(var(--ink));
    stroke-width: 1.35;
  }

  .spiral__ghost {
    stroke: hsl(var(--signal) / 0.42);
    stroke-width: 1.1;
    animation-delay: 0.05s;
  }

  .spiral__node circle {
    fill: hsl(var(--ink));
    opacity: 0;
    animation: v4-pop 0.55s cubic-bezier(0.2, 1.3, 0.4, 1) var(--delay, 0s) forwards;
  }

  .spiral__halo {
    fill: none !important;
    stroke: hsl(var(--signal));
    stroke-width: 1;
    opacity: 0;
    animation: v4-halo 0.9s ease-out var(--delay, 0s) forwards;
  }

  .spiral__pulse {
    fill: hsl(var(--signal));
    filter: drop-shadow(0 0 6px hsl(var(--signal) / 0.55));
    /* animateMotion only takes over at 2.4s — stay hidden until then. */
    opacity: 0;
    animation: v4-pop 0.4s ease 2.4s forwards;
  }

  @keyframes v4-draw {
    to {
      stroke-dashoffset: 0;
