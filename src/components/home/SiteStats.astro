---
import { getCollection } from 'astro:content'

import Section from './Section.astro'

interface Props {
  lang?: 'zh' | 'en'
}

const { lang = 'zh' } = Astro.props as Props

const [blogPosts, notes, talks] = await Promise.all([
  getCollection('blog', ({ data }) => !data.draft),
  getCollection('notes', ({ data }) => !data.draft),
  getCollection('talks', ({ data }) => !data.draft && data.status === 'published')
])

// Total page views from Waline's wl_counter table. The page is prerendered,
// so this is read once at build time and baked into the HTML. We query the
// Neon Postgres database directly (same DB the Waline server uses) because
// @waline/vercel does not ship a /api/stats endpoint — the previous attempt
// always got a 404 and baked a '—' into the homepage. Stays null if the DB is
// unreachable at build time, which is honest about not knowing.
let pageViews: number | null = null
const databaseUrl = import.meta.env.WALINE_DATABASE_URL
if (databaseUrl) {
  try {
    const { neon } = await import('@neondatabase/serverless')
    const rows = (await neon(
      databaseUrl
    )`SELECT SUM(time) AS total FROM wl_counter`) as Array<{ total: string | number }>
    const n = Number(rows[0]?.total)
    if (Number.isFinite(n)) pageViews = n
  } catch {
    // Network/auth issue — leave pageViews unknown.
  }
}

const labels =
  lang === 'en'
    ? {
        title: 'Site stats',
        blog: 'Posts',
        notes: 'Notes',
        talks: 'Talks',
        pageViews: 'Page views'
      }
    : {
        title: '站点统计',
        blog: '文章',
        notes: '笔记',
        talks: '分享',
        pageViews: '浏览量'
      }

const items = [
  { label: labels.blog, value: blogPosts.length.toString() },
  { label: labels.notes, value: notes.length.toString() },
  { label: labels.talks, value: talks.length.toString() },
  { label: labels.pageViews, value: pageViews === null ? '—' : pageViews.toLocaleString() }
]
---

<Section title={labels.title}>
  <div class='grid grid-cols-2 gap-3 sm:grid-cols-4'>
    {
      items.map(({ label, value }) => (
        <div class='rounded-xl border bg-muted/30 px-4 py-3 text-center'>
          <div class='text-2xl font-medium tabular-nums'>{value}</div>
          <div class='mt-1 text-xs text-muted-foreground'>{label}</div>
        </div>
      ))
    }
  </div>
</Section>
